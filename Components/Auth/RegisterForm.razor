@page "/register"
@rendermode InteractiveServer
@layout BASTION.Components.Layout.MainLayout
@inject BASTION.Services.Auth.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="gate-airlock">
    <div class="gate-form-side">
        <div class="gate-form-container">
            <div class="gate-logo">
                <div class="gate-logo-icon">
                    <i class="bi bi-shield-lock-fill" style="color: white;"></i>
                </div>
                <h1>BASTION</h1>
                <p>Create Your Fortress</p>
            </div>

            <div class="gate-glass-form">
                <!-- Step Indicators -->
                <div class="gate-steps">
                    <div class="gate-step">
                        <div class="gate-step-dot @(_step == 1 ? "active" : _step > 1 ? "completed" : "")">
                            @(_step > 1 ? "✓" : "1")
                        </div>
                    </div>
                    <div class="gate-step-line @(_step > 1 ? "active" : "")"></div>
                    <div class="gate-step">
                        <div class="gate-step-dot @(_step == 2 ? "active" : _step > 2 ? "completed" : "")">
                            @(_step > 2 ? "✓" : "2")
                        </div>
                    </div>
                    <div class="gate-step-line @(_step > 2 ? "active" : "")"></div>
                    <div class="gate-step">
                        <div class="gate-step-dot @(_step == 3 ? "active" : "")">3</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="gate-error">
                        <i class="bi bi-exclamation-circle"></i> @_errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="gate-success">
                        <i class="bi bi-check-circle"></i> @_successMessage
                    </div>
                }

                <!-- Step 1: Account Details -->
                @if (_step == 1)
                {
                    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; color: #ffffff;">Account Details</h3>

                    <div class="gate-input-group">
                        <label>Full Name</label>
                        <input type="text" class="gate-input" placeholder="John Doe" @bind="_model.FullName" @bind:event="oninput" />
                    </div>

                    <div class="gate-input-group">
                        <label>Email Address</label>
                        <input type="email" class="gate-input" placeholder="you@example.com" @bind="_model.Email" @bind:event="oninput" />
                    </div>

                    <div class="gate-input-group">
                        <label>Password</label>
                        <input type="password" class="gate-input" placeholder="Min 8 characters" value="@_model.Password" @oninput="OnPasswordInput" />
                        <!-- Strength Meter -->
                        <div class="strength-meter">
                            <div class="strength-bar-bg">
                                <div class="strength-bar-fill" style="width: @_strengthPercent%; background-color: @_strengthColor;"></div>
                            </div>
                            <div class="strength-label">
                                <span style="color: @_strengthColor;">@_strengthText</span>
                                <span style="color: var(--text-muted-dark);">@_entropy bits entropy</span>
                            </div>
                        </div>
                    </div>

                    <div class="gate-input-group">
                        <label>Confirm Password</label>
                        <input type="password" class="gate-input @(_model.ConfirmPassword.Length > 0 && _model.Password != _model.ConfirmPassword ? "input-error" : "")"
                               placeholder="Re-enter password" @bind="_model.ConfirmPassword" @bind:event="oninput" />
                        @if (_model.ConfirmPassword.Length > 0 && _model.Password != _model.ConfirmPassword)
                        {
                            <span style="font-size: 0.8rem; color: var(--danger); margin-top: 4px; display: block;">Passwords do not match</span>
                        }
                    </div>

                    <button class="btn-gate btn-gate-primary" @onclick="GoToStep2"
                            disabled="@(string.IsNullOrWhiteSpace(_model.FullName) || string.IsNullOrWhiteSpace(_model.Email) || _model.Password.Length < 8 || _model.Password != _model.ConfirmPassword)">
                        Continue <i class="bi bi-arrow-right"></i>
                    </button>
                }

                <!-- Step 2: Profile Setup -->
                @if (_step == 2)
                {
                    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; color: #ffffff;">Profile Setup</h3>

                    <div class="gate-input-group">
                        <label>City (for localized scam feed)</label>
                        <select class="gate-input" @bind="_model.City">
                            <option value="">Select your city</option>
                            <option value="Islamabad">Islamabad</option>
                            <option value="Karachi">Karachi</option>
                            <option value="Lahore">Lahore</option>
                            <option value="Rawalpindi">Rawalpindi</option>
                            <option value="Peshawar">Peshawar</option>
                            <option value="Quetta">Quetta</option>
                            <option value="Faisalabad">Faisalabad</option>
                            <option value="Multan">Multan</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div style="display: flex; gap: 12px;">
                        <button class="btn-gate btn-gate-outline" style="flex: 0 0 auto;" @onclick="() => _step = 1">
                            <i class="bi bi-arrow-left"></i> Back
                        </button>
                        <button class="btn-gate btn-gate-primary" style="flex: 1;" @onclick="GoToStep3">
                            Continue <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                }

                <!-- Step 3: Confirmation -->
                @if (_step == 3)
                {
                    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; color: #ffffff;">Confirm & Create</h3>

                    <div style="background: rgba(255,255,255,0.03); border-radius: var(--radius-md); padding: 16px; margin-bottom: 20px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem;">
                            <span style="color: var(--text-muted-dark);">Name</span>
                            <span style="color: #ffffff;">@_model.FullName</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem;">
                            <span style="color: var(--text-muted-dark);">Email</span>
                            <span style="color: #ffffff;">@_model.Email</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.85rem;">
                            <span style="color: var(--text-muted-dark);">City</span>
                            <span style="color: #ffffff;">@(string.IsNullOrEmpty(_model.City) ? "Not specified" : _model.City)</span>
                        </div>
                    </div>

                    <div style="display: flex; gap: 12px;">
                        <button class="btn-gate btn-gate-outline" style="flex: 0 0 auto;" @onclick="() => _step = 2">
                            <i class="bi bi-arrow-left"></i> Back
                        </button>
                        <button class="btn-gate btn-gate-primary" style="flex: 1;" @onclick="HandleRegister" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span>Creating account...</span>
                            }
                            else
                            {
                                <i class="bi bi-shield-check"></i>
                                <span>Create Account</span>
                            }
                        </button>
                    </div>
                }

                <div class="gate-footer">
                    Already have an account? <a href="/login">Sign in</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tips Side -->
    <div class="gate-tips-side">
        <div class="gate-tip-card">
            <div class="gate-tip-icon">🔐</div>
            <h3 class="gate-tip-title">Secure by Design</h3>
            <p class="gate-tip-text">Your password is hashed with industry-standard algorithms. BASTION never stores your password in plain text. We use zero-knowledge verification.</p>
        </div>
    </div>
</div>

@code {
    private RegisterModel _model = new();
    private int _step = 1;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;

    // Password strength
    private int _strengthPercent;
    private string _strengthColor = "transparent";
    private string _strengthText = "";
    private int _entropy;

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
            Navigation.NavigateTo("/");
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        var pw = e.Value?.ToString() ?? "";
        _model.Password = pw;
        CalculateStrength(pw);
    }

    private void CalculateStrength(string password)
    {
        if (string.IsNullOrEmpty(password)) { _strengthPercent = 0; _strengthText = ""; _strengthColor = "transparent"; _entropy = 0; return; }

        int charsetSize = 0;
        if (password.Any(char.IsLower)) charsetSize += 26;
        if (password.Any(char.IsUpper)) charsetSize += 26;
        if (password.Any(char.IsDigit)) charsetSize += 10;
        if (password.Any(c => !char.IsLetterOrDigit(c))) charsetSize += 33;

        _entropy = (int)(password.Length * Math.Log2(charsetSize > 0 ? charsetSize : 1));

        if (_entropy < 28) { _strengthPercent = 20; _strengthColor = "#EF4444"; _strengthText = "Weak"; }
        else if (_entropy < 36) { _strengthPercent = 40; _strengthColor = "#F97316"; _strengthText = "Fair"; }
        else if (_entropy < 60) { _strengthPercent = 65; _strengthColor = "#F59E0B"; _strengthText = "Good"; }
        else if (_entropy < 80) { _strengthPercent = 85; _strengthColor = "#10B981"; _strengthText = "Strong"; }
        else { _strengthPercent = 100; _strengthColor = "#059669"; _strengthText = "Excellent"; }
    }

    private void GoToStep2()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_model.FullName) || string.IsNullOrWhiteSpace(_model.Email))
        { _errorMessage = "Please fill all required fields."; return; }
        if (_model.Password.Length < 8)
        { _errorMessage = "Password must be at least 8 characters."; return; }
        if (_model.Password != _model.ConfirmPassword)
        { _errorMessage = "Passwords do not match."; return; }
        _step = 2;
    }

    private void GoToStep3()
    {
        _errorMessage = null;
        _step = 3;
    }

    private async Task HandleRegister()
    {
        _errorMessage = null;
        _isLoading = true;
        StateHasChanged();

        await Task.Delay(1000);

        var result = AuthService.Register(_model.FullName, _model.Email, _model.Password, _model.City);

        if (result.Success)
        {
            _successMessage = result.Message + " Redirecting to login...";
            StateHasChanged();
            await Task.Delay(1500);
            Navigation.NavigateTo("/login");
        }
        else
        {
            _errorMessage = result.Message;
            _isLoading = false;
        }
    }

    private class RegisterModel
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
        public string City { get; set; } = "";
    }
}
