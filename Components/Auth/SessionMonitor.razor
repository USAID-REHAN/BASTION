@inject BASTION.Services.Auth.AuthService AuthService

<div class="settings-card">
    <div class="settings-card-title">Active Sessions</div>
    <div class="settings-card-desc">Manage your active sessions and devices</div>

    <div class="session-list" style="display: flex; flex-direction: column; gap: 16px; margin-top: 20px;">
        @if (_sessions == null || !_sessions.Any())
        {
            <div class="text-muted">No active sessions found.</div>
        }
        else
        {
            @foreach (var session in _sessions)
            {
                <div class="session-item" style="display: flex; justify-content: space-between; align-items: center; padding: 12px; background: rgba(255,255,255,0.03); border-radius: 8px;">
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <div style="font-size: 1.5rem; color: var(--text-muted-dark);">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <div>
                            <div style="font-weight: 600; color: #ffffff;">@session.Device</div>
                            <div style="font-size: 0.85rem; color: var(--text-muted-dark);">
                                <span><i class="bi bi-geo-alt"></i> @session.Location</span>
                                <span style="margin-left: 12px;"><i class="bi bi-clock"></i> @session.LoginTime.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>
                    </div>
                    <div>
                        @if (session.IsActive)
                        {
                            <span style="display: inline-block; padding: 4px 8px; background: rgba(16, 185, 129, 0.2); color: #10b981; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">Active</span>
                        }
                        else if (session.IsRevokedByAdmin)
                        {
                            <span style="display: inline-block; padding: 4px 8px; background: rgba(220, 38, 38, 0.2); color: #ef4444; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">Revoked</span>
                        }
                        else
                        {
                            <span style="display: inline-block; padding: 4px 8px; background: rgba(148, 163, 184, 0.2); color: #94a3b8; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">Terminated</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<BASTION.Services.Auth.SessionInfo> _sessions = new();

    protected override void OnInitialized()
    {
        _sessions = AuthService.GetActiveSessions();
    }
}
