<!-- PasswordBreachChecker.razor — Password input → SHA-1 hash → HIBP k-Anon → result -->

@inject IJSRuntime JS
@inject BASTION.Data.BastionDbContext DbContext
@inject BASTION.Services.Auth.AuthService AuthService

<div class="cyber-card">
    <div class="cyber-card-title">
        <i class="bi bi-key-fill"></i>
        Password Breach Checker
    </div>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 20px;">
        <i class="bi bi-shield-lock"></i>
        Your password never leaves your browser. We use k-Anonymity — only the first 5 characters of the SHA-1 hash
        are sent to Have I Been Pwned.
    </p>

    <!-- Password Input -->
    <div class="cyber-password-group">
        <input type="@(_showPassword ? "text" : "password")"
               @bind="_password"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               placeholder="Enter a password to check..."
               id="breach-password-input" />
        <button class="cyber-password-toggle" @onclick="() => _showPassword = !_showPassword"
                title="@(_showPassword ? "Hide" : "Show") password" id="breach-toggle-visibility">
            <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
        </button>
    </div>

    <!-- Strength Meter -->
    @if (!string.IsNullOrEmpty(_password))
    {
        <div class="cyber-strength-container">
            <div class="cyber-strength-bar-bg">
                <div class="cyber-strength-bar-fill"
                     style="width: @(Math.Min(_entropy, 100))%; background: @GetStrengthColor();"></div>
            </div>
            <div class="cyber-strength-labels">
                <span style="color: @GetStrengthColor();">@GetStrengthLabel()</span>
                <span style="color: var(--text-muted);">Entropy: @_entropy bits</span>
            </div>
        </div>
    }

    <!-- Check Button -->
    <div style="margin-top: 20px;">
        <button class="btn-cyber" @onclick="CheckBreach"
                disabled="@(_isChecking || string.IsNullOrWhiteSpace(_password))" id="breach-check-btn">
            @if (_isChecking)
            {
                <div class="cyber-spinner" style="width: 18px; height: 18px; border-width: 2px;"></div>
                <span>Checking...</span>
            }
            else
            {
                <i class="bi bi-search"></i>
                <span>Check Breach</span>
            }
        </button>
    </div>
</div>

<!-- Result -->
@if (_resultShown)
{
    @if (_breachCount == 0)
    {
        <div class="cyber-breach-result safe">
            <div class="cyber-breach-icon">✅</div>
            <div class="cyber-breach-info">
                <h3 style="color: var(--success);">No Breaches Found!</h3>
                <p>This password has not appeared in any known data breaches. Keep it strong!</p>
            </div>
            <span class="badge-bastion badge-safe" style="margin-left: auto; font-size: 0.85rem;">SAFE</span>
        </div>
    }
    else
    {
        <div class="cyber-breach-result breached">
            <div class="cyber-breach-icon">🚨</div>
            <div class="cyber-breach-info">
                <h3 style="color: var(--danger);">Password Compromised!</h3>
                <p>This password has appeared in <strong>@_breachCount.ToString("N0")</strong> known data breach(es). You should change it immediately.</p>
            </div>
            <span class="badge-bastion badge-danger" style="margin-left: auto; font-size: 0.85rem;">BREACHED</span>
        </div>
    }
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="cyber-card" style="color: var(--danger);">
        <i class="bi bi-x-circle"></i> @_errorMessage
    </div>
}

@code {
    private string _password = "";
    private bool _showPassword;
    private bool _isChecking;
    private bool _resultShown;
    private int _breachCount;
    private int _entropy;
    private string? _errorMessage;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CheckBreach();
    }

    // Re-calculate entropy whenever password changes via binding
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(_password))
        {
            try
            {
                var ent = await JS.InvokeAsync<int>("bastionPassword.calculateEntropy", _password);
                if (ent != _entropy)
                {
                    _entropy = ent;
                    StateHasChanged();
                }
            }
            catch { /* JS not ready */ }
        }
    }

    private async Task CheckBreach()
    {
        if (string.IsNullOrWhiteSpace(_password) || _isChecking) return;

        _isChecking = true;
        _resultShown = false;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            // Step 1: SHA-1 hash entirely in C# (client-side in Blazor Server context)
            var sha1Hash = ComputeSha1(_password);
            var prefix = sha1Hash.Substring(0, 5);
            var suffix = sha1Hash.Substring(5);

            // Step 2: Send only the 5-char prefix to HIBP
            using var client = new HttpClient();
            client.DefaultRequestHeaders.Add("User-Agent", "BASTION-CyberShield");
            var response = await client.GetAsync($"https://api.pwnedpasswords.com/range/{prefix}");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Failed to reach Have I Been Pwned API.";
                _isChecking = false;
                return;
            }

            // Step 3: Check if our suffix appears in the response
            var body = await response.Content.ReadAsStringAsync();
            _breachCount = 0;

            foreach (var line in body.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = line.Trim().Split(':');
                if (parts.Length == 2 && parts[0].Equals(suffix, StringComparison.OrdinalIgnoreCase))
                {
                    _breachCount = int.TryParse(parts[1].Trim(), out var count) ? count : 0;
                    break;
                }
            }

            _resultShown = true;
            await SaveSecurityScan();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isChecking = false;
        }
    }

    /// <summary>
    /// Compute SHA-1 hash of a string — used for HIBP k-Anonymity.
    /// Only the first 5 chars of the hash are sent over the network.
    /// </summary>
    private static string ComputeSha1(string input)
    {
        using var sha1 = System.Security.Cryptography.SHA1.Create();
        var bytes = System.Text.Encoding.UTF8.GetBytes(input);
        var hash = sha1.ComputeHash(bytes);
        return BitConverter.ToString(hash).Replace("-", "");
    }

    private string GetStrengthColor()
    {
        if (_entropy <= 27) return "var(--danger)";
        if (_entropy <= 49) return "var(--warning)";
        if (_entropy <= 69) return "var(--cyber-primary)";
        return "var(--success)";
    }

    private string GetStrengthLabel()
    {
        if (_entropy <= 27) return "Weak";
        if (_entropy <= 49) return "Fair";
        if (_entropy <= 69) return "Strong";
        return "Very Strong";
    }

    private async Task SaveSecurityScan()
    {
        var email = AuthService.CurrentUser?.Email ?? "anonymous";
        var resultText = _breachCount == 0
            ? "No breaches found"
            : $"Password appeared in {_breachCount:N0} known breaches";

        DbContext.SecurityScanLogs.Add(new BASTION.Models.SecurityScanLog
        {
            Email = email,
            ScanType = "Password Breach",
            Target = "Password hash prefix check",
            Result = resultText,
            CreatedAt = DateTime.UtcNow
        });
        DbContext.AuditLogs.Add(new BASTION.Models.AuditLog
        {
            Email = email,
            Action = "CyberShield Password Breach Scan",
            Timestamp = DateTime.UtcNow,
            Details = resultText
        });
        await DbContext.SaveChangesAsync();
    }
}
