@page "/about"
@rendermode InteractiveServer

<PageTitle>BASTION — About</PageTitle>

<div class="home-dashboard">
    <div class="home-header">
        <div class="home-greeting">
            <h1>About BASTION</h1>
            <p>Your Digital Fortress</p>
        </div>
    </div>

    <div class="glass-card" style="padding: 30px; margin-bottom: 30px;">
        <h2 style="color: #ffffff; margin-bottom: 16px;">The Vision</h2>
        <p style="color: var(--text-muted); line-height: 1.6;">
            BASTION is a state-of-the-art modular security suite designed to protect users from modern digital threats. 
            Built on a strict "Zero-Coupling" architecture, every module operates independently, ensuring maximum reliability and flexibility.
        </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        <div class="glass-card" style="padding: 20px;">
            <h3 style="color: var(--cyber-primary);"><i class="bi bi-shield-check"></i> CyberShield</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Device protection, PowerShell audit, IP checker, and password breach checking.</p>
        </div>
        <div class="glass-card" style="padding: 20px;">
            <h3 style="color: var(--lex-primary);"><i class="bi bi-file-earmark-text"></i> LexGuard</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Document protection, AI contract analysis, clause highlights, and PDF export.</p>
        </div>
        <div class="glass-card" style="padding: 20px;">
            <h3 style="color: var(--fin-primary);"><i class="bi bi-currency-dollar"></i> FinShield</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Fraud protection, URL scanner, message analyzer, and scam feed.</p>
        </div>
        <div class="glass-card" style="padding: 20px;">
            <h3 style="color: var(--hacker-primary);"><i class="bi bi-controller"></i> HackerLab</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Security academy with 5 domains, mini-games, XP, badges, and rank progression.</p>
        </div>
    </div>
</div>
