@page "/"
@rendermode InteractiveServer

<PageTitle>BASTION — Dashboard</PageTitle>

<div class="home-dashboard" style="min-height: 100vh; transition: all 0.3s ease; width: 100% !important;">
    <div style="max-width: 1400px; margin: 0 auto; padding: 40px;">
        
        <!-- Hero Header -->
        <div class="hero-header" style="margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <span style="text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; color: #00f3ff; font-weight: 700;">System Status</span>
                <h1 style="font-size: 2.5rem; font-weight: 900; margin: 8px 0; background: linear-gradient(to right, #ffffff, #94a3b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;" class="hero-title">
                    Welcome back, @AuthService.CurrentUser?.FullName?.Split(' ')[0]
                </h1>
                <p style="color: rgba(255,255,255,0.6); font-size: 1rem;" class="hero-desc">All systems are operational. Your fortress is secure.</p>
            </div>
            <div class="home-clock" id="dashboard-clock" style="font-size: 1.5rem; font-family: monospace; color: #00f3ff; text-shadow: 0 0 10px rgba(0, 243, 255, 0.3); background: var(--glass-bg); padding: 12px 24px; border-radius: 12px; border: 1px solid var(--glass-border);"></div>
        </div>

        <!-- Main Grid Layout -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px;">
            
            <!-- Left Column -->
            <div style="display: flex; flex-direction: column; gap: 30px;">
                
                <!-- Overall Protection Card (Large Banner) -->
                <div style="background: linear-gradient(135deg, rgba(0, 243, 255, 0.05) 0%, rgba(255, 0, 85, 0.05) 100%); border-radius: 20px; padding: 30px; border: 1px solid var(--glass-border); position: relative; overflow: hidden;">
                    <div style="position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: linear-gradient(to bottom, #00f3ff, #ff0055);"></div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 8px;">Overall Protection</h2>
                            <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem;" class="card-desc">Calculated based on your active modules, XP, and security posture.</p>
                        </div>
                        <div style="text-align: center;">
                            <div id="score-value" style="font-size: 3.5rem; font-weight: 900; color: #ffffff; line-height: 1;" class="score-text">0</div>
                            <span style="font-size: 0.8rem; color: #00f3ff; letter-spacing: 1px; text-transform: uppercase; font-weight: 700;">Score</span>
                        </div>
                    </div>
                    
                    <!-- Sleek horizontal progress bar -->
                    <div style="height: 6px; background: rgba(255,255,255,0.05); border-radius: 3px; margin-top: 20px; overflow: hidden;" class="progress-bg">
                        <div id="score-bar" style="height: 100%; width: @(_gaugeAnimated ? _protectionScore : 0)%; background: linear-gradient(to right, #00f3ff, #ff0055); border-radius: 3px; transition: width 1.5s ease-out;"></div>
                    </div>
                </div>

                <!-- Quick Access / Quick Actions -->
                <div>
                    <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 16px; color: rgba(255,255,255,0.6);" class="section-title">Quick Access</h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px;">
                        @foreach (var module in Modules.Where(m => m.Name != "GateKeeper" && m.Name != "Dashboard").OrderBy(m => m.Order))
                        {
                            <a href="@module.RouteUrl" style="background: var(--glass-bg); padding: 20px; border-radius: 16px; border: 1px solid var(--glass-border); text-decoration: none; display: flex; flex-direction: column; gap: 12px; transition: all 0.3s ease; position: relative; overflow: hidden;" class="home-module-card">
                                <div style="width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, @module.PrimaryHex, @(module.PrimaryHex)55); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: white;">
                                    <i class="bi @module.Icon"></i>
                                </div>
                                <div>
                                    <div style="font-weight: 700; color: #ffffff;" class="module-name">@module.Name</div>
                                    <div style="font-size: 0.75rem; color: rgba(255,255,255,0.5); margin-top: 4px;" class="module-desc">@module.Description.Substring(0, Math.Min(40, module.Description.Length))...</div>
                                </div>
                                <div style="position: absolute; bottom: 0; right: 0; width: 30px; height: 30px; background: rgba(255,255,255,0.02); display: flex; align-items: center; justify-content: center; border-radius: 16px 0 0 0; font-size: 0.8rem; color: rgba(255,255,255,0.3);" class="module-arrow">
                                    <i class="bi bi-arrow-right"></i>
                                </div>
                            </a>
                        }
                    </div>
                </div>

                <!-- Security Checklist & Telemetry Split -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    
                    <!-- Security Checklist -->
                    <div style="background: var(--glass-bg); padding: 20px; border-radius: 16px; border: 1px solid var(--glass-border);">
                        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; color: #ffffff;" class="widget-title">Security Checklist</h3>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
                                <i class="bi @(AuthService.CurrentUser?.MfaEnabled == true ? "bi-check-circle-fill text-success" : "bi-circle text-muted")"></i>
                                <span>Multi-Factor Authentication</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
                                <i class="bi @(XpService.CurrentXp >= 100 ? "bi-check-circle-fill text-success" : "bi-circle text-muted")"></i>
                                <span>Academy Training (Lvl 1)</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
                                <i class="bi @(_scansCompleted > 0 ? "bi-check-circle-fill text-success" : "bi-circle text-muted")"></i>
                                <span>Initial System Scan</span>
                            </div>
                        </div>
                    </div>

                    <!-- Telemetry -->
                    <div style="background: var(--glass-bg); padding: 20px; border-radius: 16px; border: 1px solid var(--glass-border);">
                        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; color: #ffffff;" class="widget-title">System Telemetry</h3>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem;">
                                <span style="color: rgba(255,255,255,0.6);" class="telemetry-label">Active Shields</span>
                                <span style="font-weight: 700; color: #00f3ff;">@_activeModules</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem;">
                                <span style="color: rgba(255,255,255,0.6);" class="telemetry-label">Threats Deflected</span>
                                <span style="font-weight: 700; color: #22c55e;">@_scansCompleted</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem;">
                                <span style="color: rgba(255,255,255,0.6);" class="telemetry-label">Clearance Level</span>
                                <span style="font-weight: 700; color: #ff0055;">@_userRank</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column (Activity & News) -->
            <div style="display: flex; flex-direction: column; gap: 30px;">
                
                <!-- Live Feed -->
                <div style="background: var(--glass-bg); padding: 20px; border-radius: 16px; border: 1px solid var(--glass-border); flex: 1; display: flex; flex-direction: column;">
                    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; color: #ffffff;" class="widget-title">Live Activity</h3>
                    <div style="display: flex; flex-direction: column; gap: 14px; overflow-y: auto; max-height: 400px;">
                        @foreach (var activity in _activities)
                        {
                            <div style="display: flex; gap: 12px; align-items: flex-start; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.02);" class="activity-item">
                                <div style="width: 8px; height: 8px; border-radius: 50%; background: @activity.Color; margin-top: 6px; flex-shrink: 0;"></div>
                                <div>
                                    <div style="font-size: 0.85rem; color: #ffffff;" class="activity-text">@activity.Text</div>
                                    <div style="font-size: 0.7rem; color: rgba(255,255,255,0.4); margin-top: 2px;" class="activity-time">@activity.Time</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Terminal Widget -->
                <div style="background: #000000; padding: 20px; border-radius: 16px; border: 1px solid rgba(0, 243, 255, 0.1); font-family: monospace;">
                    <div style="display: flex; gap: 6px; margin-bottom: 10px;">
                        <div style="width: 8px; height: 8px; border-radius: 50%; background: #ff5f56;"></div>
                        <div style="width: 8px; height: 8px; border-radius: 50%; background: #ffbd2e;"></div>
                        <div style="width: 8px; height: 8px; border-radius: 50%; background: #27c93f;"></div>
                    </div>
                    <div style="color: #00f3ff; font-size: 0.8rem;">$ status check</div>
                    <div style="color: rgba(255,255,255,0.6); font-size: 0.8rem; margin-top: 4px;">> Database: Connected</div>
                    <div style="color: rgba(255,255,255,0.6); font-size: 0.8rem;">> Shields: Online</div>
                    <div style="color: rgba(255,255,255,0.6); font-size: 0.8rem;">> Session: Secure</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .home-dashboard {
        background: #05070c;
        color: #ffffff;
        --glass-bg: rgba(255, 255, 255, 0.01);
        --glass-border: rgba(255, 255, 255, 0.03);
        border-left: 1px solid rgba(255, 255, 255, 0.05);
    }

    .bastion-light .home-dashboard {
        background: var(--bg-light);
        color: var(--text-dark);
        --glass-bg: #FFFFFF;
        --glass-border: rgba(0, 0, 0, 0.1);
        border-left: 1px solid rgba(0, 0, 0, 0.05);
    }

    .bastion-light .hero-title { background: none !important; -webkit-text-fill-color: initial !important; color: var(--text-dark) !important; }
    .bastion-light .hero-desc { color: var(--text-muted) !important; }
    .bastion-light .card-desc { color: var(--text-muted) !important; }
    .bastion-light .score-text { color: var(--text-dark) !important; }
    .bastion-light .progress-bg { background: rgba(0,0,0,0.05) !important; }
    .bastion-light .section-title { color: var(--text-muted) !important; }
    .bastion-light .module-name { color: var(--text-dark) !important; }
    .bastion-light .module-desc { color: var(--text-muted) !important; }
    .bastion-light .widget-title { color: var(--text-dark) !important; }
    .bastion-light .telemetry-label { color: var(--text-muted) !important; }
    .bastion-light .activity-item { border-color: rgba(0,0,0,0.05) !important; }
    .bastion-light .activity-text { color: var(--text-dark) !important; }
    .bastion-light .activity-time { color: var(--text-muted) !important; }
    .bastion-light .module-arrow { background: rgba(0,0,0,0.02) !important; color: var(--text-muted) !important; }

    .home-module-card:hover {
        background: var(--surface-current) !important;
        border-color: var(--glass-border) !important;
        transform: translateY(-2px);
    }
</style>
