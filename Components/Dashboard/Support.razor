@page "/support"
@using BASTION.Models
@using BASTION.Services.Support
@using BASTION.Services.Auth
@using BASTION.Services.AI
@using Microsoft.EntityFrameworkCore
@inject SupportAgentService AgentService
@inject AuthService AuthService
@inject BASTION.Services.Support.MarkdownParserService MarkdownParser
@inject BASTION.Data.BastionDbContext DbContext
@rendermode InteractiveServer

<PageTitle>BASTION — Support & Documentation</PageTitle>

<div class="home-dashboard" style="max-width: 1200px; margin: 0 auto; padding: 20px; font-family: 'Inter', sans-serif;">
    
    <!-- Header -->
    <div class="home-header" style="margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div class="home-greeting">
            @if (_viewDocsMode)
            {
                <h1 style="font-size: 2.2rem; font-weight: 800; display: flex; align-items: center; gap: 12px; margin: 0;">
                    <i class="bi bi-journal-text" style="color: var(--cyber-primary);"></i> BASTION Documentation
                </h1>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px; margin-bottom: 0;">Comprehensive user manuals, architectural details, and guides.</p>
            }
            else if (_viewChatMode)
            {
                <h1 style="font-size: 2.2rem; font-weight: 800; display: flex; align-items: center; gap: 12px; margin: 0;">
                    <i class="bi bi-chat-dots-fill" style="color: var(--cyber-primary);"></i> Live Chat Support
                </h1>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px; margin-bottom: 0;">Autonomous Sentinel-AI Co-pilot active and ready.</p>
            }
            else if (_viewTicketsMode)
            {
                <h1 style="font-size: 2.2rem; font-weight: 800; display: flex; align-items: center; gap: 12px; margin: 0;">
                    <i class="bi bi-ticket-perforated-fill" style="color: #10b981;"></i> Tickets Dispatch
                </h1>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px; margin-bottom: 0;">Autonomous agentic ticket investigation & diagnostic logs.</p>
            }
            else
            {
                <h1 style="font-size: 2.2rem; font-weight: 800; margin: 0;">Support Center</h1>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px; margin-bottom: 0;">How can we help you today?</p>
            }
        </div>
        
        @if (_viewDocsMode || _viewChatMode || _viewTicketsMode)
        {
            <button class="btn-ghost-bastion" @onclick="ReturnToHome" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px;">
                <i class="bi bi-arrow-left"></i> Support Portal Home
            </button>
        }
    </div>

    <!-- Alert / Toast Banner -->
    @if (!string.IsNullOrEmpty(_toastMessage))
    {
        <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 8px; padding: 12px 20px; margin-bottom: 24px; color: #34d399; display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem; animation: slideIn 0.3s ease;">
            <span style="display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-check-circle"></i> @_toastMessage
            </span>
            <button style="background: none; border: none; color: #34d399; cursor: pointer; font-size: 1.1rem;" @onclick="() => _toastMessage = null">×</button>
        </div>
    }

    <!-- ── VIEW 1: Support Portal Home ── -->
    @if (!_viewDocsMode && !_viewChatMode && !_viewTicketsMode)
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-bottom: 32px;">
            
            <!-- Live Chat Card (Autonomous Agentic) -->
            <div class="glass-card" style="padding: 30px; text-align: center; border-radius: 12px; border: 1px solid rgba(6, 182, 212, 0.3); background: linear-gradient(135deg, var(--glass-bg) 0%, rgba(6, 182, 212, 0.02) 100%); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 24px rgba(0,0,0,0.15)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';">
                <div style="width: 60px; height: 60px; background: rgba(6, 182, 212, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                    <i class="bi bi-chat-dots-fill" style="font-size: 1.8rem; color: var(--cyber-primary);"></i>
                </div>
                <h3 style="font-weight: 700; margin-bottom: 10px;">Live Chat Co-pilot</h3>
                <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-bottom: 20px;">Consult with BASTION-Sentinel AI. The agent can dynamically inspect platform configs or active sessions using C# tools.</p>
                <button class="btn-action" style="width: 100%; justify-content: center; background: var(--cyber-primary); border-color: var(--cyber-primary); color: white; font-weight: 600;" @onclick="StartChat">Start Chat</button>
            </div>

            <!-- Support Tickets Card (Autonomous Agentic) -->
            <div class="glass-card" style="padding: 30px; text-align: center; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.3); background: linear-gradient(135deg, var(--glass-bg) 0%, rgba(16, 185, 129, 0.02) 100%); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 24px rgba(0,0,0,0.15)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';">
                <div style="width: 60px; height: 60px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                    <i class="bi bi-ticket-perforated-fill" style="font-size: 1.8rem; color: #10b981;"></i>
                </div>
                <h3 style="font-weight: 700; margin-bottom: 10px;">Auto-Ticket Solver</h3>
                <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-bottom: 20px;">Submit diagnostic tickets. Our agent runs automated scans, config adjustments, and database repairs instantly.</p>
                <button class="btn-action" style="width: 100%; justify-content: center; background: #10b981; border-color: #10b981; color: white; font-weight: 600;" @onclick="StartTickets">Create / View Tickets</button>
            </div>

            <!-- Documentation Card -->
            <div class="glass-card" style="padding: 30px; text-align: center; border-radius: 12px; border: 1px solid rgba(245, 158, 11, 0.3); background: linear-gradient(135deg, var(--glass-bg) 0%, rgba(245, 158, 11, 0.02) 100%); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 24px rgba(0,0,0,0.15)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';">
                <div style="width: 60px; height: 60px; background: rgba(245, 158, 11, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                    <i class="bi bi-journal-text" style="font-size: 1.8rem; color: #f59e0b;"></i>
                </div>
                <h3 style="font-weight: 700; margin-bottom: 10px;">Technical Docs</h3>
                <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-bottom: 20px;">Read comprehensive guides, manuals, threat models, and system administration definitions.</p>
                <button class="btn-action" style="width: 100%; justify-content: center; background: #f59e0b; border-color: #f59e0b; color: white; font-weight: 600;" @onclick="() => _viewDocsMode = true">View Docs</button>
            </div>
        </div>

        <!-- FAQs Section -->
        <div class="glass-card" style="padding: 30px; border-radius: 12px; border: 1px solid var(--border-current);">
            <h2 style="margin-bottom: 24px; font-weight: 800; font-size: 1.4rem; display: flex; align-items: center; gap: 10px;">
                <i class="bi bi-question-circle" style="color: var(--cyber-primary);"></i> Frequently Asked Questions
            </h2>
            <div style="display: flex; flex-direction: column; gap: 20px;">
                <div style="border-bottom: 1px solid var(--border-current); padding-bottom: 16px;">
                    <div style="font-weight: 700; font-size: 0.98rem; margin-bottom: 8px;">How do I reset my account password?</div>
                    <div style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">You can update your login password securely by going to the <strong>Settings</strong> tab in the sidebar and opening the <strong>Account Settings</strong> panel.</div>
                </div>
                <div style="border-bottom: 1px solid var(--border-current); padding-bottom: 16px;">
                    <div style="font-weight: 700; font-size: 0.98rem; margin-bottom: 8px;">Is my scanner telemetry and draft history secure?</div>
                    <div style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">Absolutely. BASTION operates under a zero-trust architecture. All document scans, PowerShell audits, URL safety checks, and LexGuard AI Smart Drafter outputs are stored exclusively in your local SQLite database (<code>bastion.db</code>). No information is transmitted to external telemetry servers.</div>
                </div>
                <div>
                    <div style="font-weight: 700; font-size: 0.98rem; margin-bottom: 8px;">Can other administrators revoke my active logins?</div>
                    <div style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">Administrators have the capability to audit all active platform sessions. However, non-admin sessions can be revoked via the Admin Portal, while main Administrator sessions are strictly protected against remote revocation to avoid administrative lockouts.</div>
                </div>
            </div>
        </div>
    }

    <!-- ── VIEW 2: AI Live Chat ── -->
    @if (_viewChatMode)
    {
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: 24px; align-items: start;">
            <!-- Left Panel: Chat Board -->
            <div class="glass-card" style="padding: 24px; display: flex; flex-direction: column; height: 580px; border-radius: 12px; border: 1px solid var(--border-current);">
                <!-- Messages List -->
                <div style="flex-grow: 1; overflow-y: auto; padding-right: 10px; display: flex; flex-direction: column; gap: 14px; margin-bottom: 20px;">
                    @foreach (var msg in _chatHistory)
                    {
                        @if (msg.Role == "user")
                        {
                            <div style="align-self: flex-end; max-width: 80%; background: var(--cyber-primary); color: white; padding: 12px 16px; border-radius: 12px 12px 0 12px; font-size: 0.92rem; line-height: 1.5; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                                @msg.Content
                            </div>
                        }
                        else
                        {
                            <div style="align-self: flex-start; max-width: 80%; background: var(--surface-current); border: 1px solid var(--border-current); color: var(--text-current); padding: 14px 18px; border-radius: 12px 12px 12px 0; font-size: 0.92rem; line-height: 1.5; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                                <div style="font-weight: 800; font-size: 0.75rem; text-transform: uppercase; color: var(--cyber-primary); margin-bottom: 6px; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px;">
                                    <i class="bi bi-shield-shaded"></i> BASTION Sentinel AI
                                </div>
                                <div class="markdown-body">
                                    @ConvertMarkdownToHtml(msg.Content)
                                </div>
                            </div>
                        }
                    }

                    @if (_isChatTyping)
                    {
                        <div style="align-self: flex-start; max-width: 80%; background: var(--surface-current); border: 1px solid var(--border-current); padding: 14px 18px; border-radius: 12px 12px 12px 0; display: flex; align-items: center; gap: 8px;">
                            <span style="color: var(--text-muted); font-size: 0.85rem; font-style: italic;">Sentinel-AI is inspecting platform configuration and thinking...</span>
                            <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                        </div>
                    }
                </div>

                <!-- Input area -->
                <div style="display: flex; gap: 12px; border-top: 1px solid var(--border-current); padding-top: 16px;">
                    <input type="text" class="input-bastion" style="flex-grow: 1;" placeholder="Ask Sentinel about system status, logins, active configs, or ask it to fix a role/session..." 
                           @bind="_userChatMessage" @onkeyup="HandleChatKeyup" disabled="@_isChatTyping" />
                    <button class="btn-action" style="background: var(--cyber-primary); border-color: var(--cyber-primary); color: white; font-weight: 600; padding: 10px 24px;" 
                            @onclick="SendChatMessage" disabled="@_isChatTyping">
                        Send <i class="bi bi-send" style="margin-left: 6px;"></i>
                    </button>
                </div>
            </div>

            <!-- Right Panel: Agentic Log Operations Dashboard -->
            <div class="glass-card" style="padding: 24px; height: 580px; border-radius: 12px; border: 1px solid rgba(6, 182, 212, 0.25); display: flex; flex-direction: column; background: var(--glass-bg);">
                <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--cyber-primary); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-cpu"></i> Agentic Operations Log
                </h3>
                <p style="color: var(--text-muted); font-size: 0.8rem; line-height: 1.4; margin-bottom: 16px; border-bottom: 1px solid var(--border-current); padding-bottom: 10px;">
                    This console registers the real-time execution steps, reasoning decisions, and local C# tool calls executed autonomously by Sentinel-AI.
                </p>

                <div style="flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; font-family: var(--font-mono); font-size: 0.76rem; padding-right: 5px;">
                    @if (!_agentSteps.Any())
                    {
                        <div style="color: var(--text-muted); text-align: center; padding-top: 60px; font-style: italic;">
                            Console idle. Send a chat query to trace autonomous tool invocations in real-time.
                        </div>
                    }
                    else
                    {
                        @foreach (var step in _agentSteps)
                        {
                            @if (step.Contains("Executed:"))
                            {
                                <div style="color: #34d399; background: rgba(52, 211, 153, 0.05); padding: 8px; border-radius: 6px; border-left: 2px solid #34d399; line-height: 1.4; word-break: break-all;">
                                    <strong style="text-transform: uppercase;">[Tool Action]</strong><br />@step
                                </div>
                            }
                            else
                            {
                                <div style="color: #38bdf8; background: rgba(56, 189, 248, 0.05); padding: 8px; border-radius: 6px; border-left: 2px solid #38bdf8; line-height: 1.4;">
                                    <strong style="text-transform: uppercase;">[Reasoning]</strong><br />@step
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── VIEW 3: Support Tickets ── -->
    @if (_viewTicketsMode)
    {
        <div style="display: grid; grid-template-columns: 400px 1fr; gap: 24px; align-items: start;">
            <!-- Left Panel: Create Ticket Form -->
            <div class="glass-card" style="padding: 24px; border-radius: 12px; border: 1px solid var(--border-current);">
                <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-plus-circle" style="color: #10b981;"></i> Submit Ticket
                </h3>
                
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Ticket Title / Area of Issue</label>
                        <input type="text" class="input-bastion" placeholder="e.g. Inactive login session / Registration closed" @bind="_newTicketTitle" disabled="@_isTicketSubmitting" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Detailed Telemetry Description</label>
                        <textarea class="input-bastion" rows="5" style="resize: none; font-family: inherit;" placeholder="Please outline the issue or specify the user email and configurations you want the AI agent to verify and resolve." @bind="_newTicketDesc" disabled="@_isTicketSubmitting"></textarea>
                    </div>
                    <button class="btn-action" style="background: #10b981; border-color: #10b981; color: white; font-weight: 600; width: 100%; justify-content: center; padding: 12px;" 
                            @onclick="CreateNewTicketAsync" disabled="@_isTicketSubmitting">
                        @if (_isTicketSubmitting)
                        {
                            <span>AI Agent is investigating...</span>
                            <div class="spinner-border spinner-border-sm text-light style='margin-left: 6px;'" role="status"></div>
                        }
                        else
                        {
                            <span>Submit Ticket to AI Solver</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Right Panel: Tickets History and AI Logs -->
            <div class="glass-card" style="padding: 24px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.25); min-height: 500px; display: flex; flex-direction: column;">
                <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-clock-history" style="color: #10b981;"></i> Active Incident List
                </h3>

                <div style="flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; padding-right: 5px;">
                    @if (!_tickets.Any())
                    {
                        <div style="text-align: center; color: var(--text-muted); padding-top: 100px; font-style: italic;">
                            No support tickets filed yet. File a ticket on the left to activate our Agentic AI repair loop.
                        </div>
                    }
                    else
                    {
                        @foreach (var ticket in _tickets)
                        {
                            <div class="glass-card" style="padding: 20px; border-radius: 8px; border: 1px solid @(ticket.Status == "Resolved" ? "rgba(16, 185, 129, 0.25)" : "var(--border-current)"); background: var(--surface-current); position: relative;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
                                    <div>
                                        <h4 style="font-size: 1.05rem; font-weight: 800; margin: 0; color: var(--text-current);">@ticket.Title</h4>
                                        <span style="font-size: 0.72rem; color: var(--text-muted);">Filed by @ticket.Email on @ticket.CreatedAt.ToString("g")</span>
                                    </div>
                                    <span style="font-size: 0.72rem; font-weight: 800; padding: 4px 10px; border-radius: 30px; letter-spacing: 0.5px; text-transform: uppercase; background: @(ticket.Status == "Resolved" ? "rgba(16, 185, 129, 0.1)" : "rgba(245, 158, 11, 0.1)"); color: @(ticket.Status == "Resolved" ? "#34d399" : "#fb923c"); border: 1px solid @(ticket.Status == "Resolved" ? "rgba(16, 185, 129, 0.2)" : "rgba(245, 158, 11, 0.2)");">
                                        @ticket.Status
                                    </span>
                                </div>
                                <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; margin-bottom: 16px; background: rgba(0,0,0,0.08); padding: 10px 14px; border-radius: 6px; border-left: 2px solid var(--border-current);">
                                    @ticket.Description
                                </p>
                                
                                @if (!string.IsNullOrEmpty(ticket.AiResolution))
                                {
                                    <div style="background: rgba(16, 185, 129, 0.04); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 8px; padding: 16px; margin-top: 12px;">
                                        <div style="font-weight: 800; font-size: 0.75rem; text-transform: uppercase; color: #10b981; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; letter-spacing: 0.5px;">
                                            <i class="bi bi-cpu"></i> Agentic Diagnostic Resolution Log
                                        </div>
                                        <div style="font-size: 0.88rem; color: var(--text-current); line-height: 1.6;" class="markdown-body">
                                            @ConvertMarkdownToHtml(ticket.AiResolution)
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── VIEW 4: Technical Documentation Hub ── -->
    @if (_viewDocsMode)
    {
        <div style="display: grid; grid-template-columns: 280px 1fr; gap: 30px; align-items: start;">
            <!-- Sidebar Navigation -->
            <div class="glass-card" style="padding: 20px; border-radius: 12px; border: 1px solid var(--border-current); display: flex; flex-direction: column; gap: 8px; background: var(--glass-bg);">
                <div style="font-size: 0.75rem; font-weight: 800; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 10px; padding-left: 10px;">Documentation Sections</div>
                
                @foreach (var doc in _docs)
                {
                    <button style="display: flex; align-items: center; gap: 12px; width: 100%; border: none; outline: none; background: @(_activeDocId == doc.Id ? "rgba(56, 189, 248, 0.1)" : "transparent"); color: @(_activeDocId == doc.Id ? "var(--text-current)" : "var(--text-muted)"); padding: 12px 16px; border-radius: 8px; font-weight: @(_activeDocId == doc.Id ? "700" : "500"); font-size: 0.9rem; text-align: left; cursor: pointer; transition: background 0.2s, color 0.2s; border: 1px solid @(_activeDocId == doc.Id ? "rgba(56, 189, 248, 0.15)" : "transparent");"
                            @onclick="() => _activeDocId = doc.Id"
                            onmouseover="this.style.background='rgba(255,255,255,0.03)'"
                            onmouseout="this.style.background='@(_activeDocId == doc.Id ? "rgba(56, 189, 248, 0.1)" : "transparent")'">
                        <i class="bi @doc.Icon" style="color: @(_activeDocId == doc.Id ? "var(--cyber-primary)" : "#64748b"); font-size: 1.1rem;"></i>
                        <span>@doc.Title</span>
                    </button>
                }
            </div>

            <!-- Active Document Content Reader -->
            <div class="glass-card" style="padding: 40px; border-radius: 12px; border: 1px solid var(--border-current); min-height: 500px; display: flex; flex-direction: column;">
                @{
                    var activeDoc = _docs.FirstOrDefault(d => d.Id == _activeDocId);
                }
                @if (activeDoc != null)
                {
                    <div style="border-bottom: 1px solid var(--border-current); padding-bottom: 20px; margin-bottom: 30px;">
                        <span style="font-size: 0.72rem; font-weight: 800; background: rgba(56, 189, 248, 0.1); color: #38bdf8; padding: 4px 10px; border-radius: 4px; letter-spacing: 0.5px; text-transform: uppercase;">BASTION Manual</span>
                        <h2 style="font-size: 2rem; font-weight: 800; margin: 10px 0 0;">@activeDoc.Title</h2>
                    </div>
                    
                    <div style="color: var(--text-current); font-size: 1.02rem; line-height: 1.8; flex-grow: 1;">
                        @((MarkupString)activeDoc.HtmlContent)
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _viewDocsMode;
    private bool _viewChatMode;
    private bool _viewTicketsMode;
    private string _activeDocId = "getting-started";
    private string? _toastMessage;

    private MarkupString ConvertMarkdownToHtml(string? markdown)
    {
        return MarkdownParser.Parse(markdown ?? string.Empty);
    }

    // Chat States
    private List<GroqChatMessage> _chatHistory = new();
    private List<string> _agentSteps = new();
    private string _userChatMessage = string.Empty;
    private bool _isChatTyping;

    // Tickets States
    private List<SupportTicket> _tickets = new();
    private string _newTicketTitle = string.Empty;
    private string _newTicketDesc = string.Empty;
    private bool _isTicketSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        try
        {
            var currentUserEmail = AuthService.CurrentUser?.Email ?? "guest@bastion.app";
            _tickets = await DbContext.SupportTickets
                .Where(t => t.Email == currentUserEmail)
                .OrderByDescending(t => t.CreatedAt)
                .ToListAsync();
        }
        catch
        {
            // Fallback for startup initialization
            _tickets = new List<SupportTicket>();
        }
    }

    private void ReturnToHome()
    {
        _viewDocsMode = false;
        _viewChatMode = false;
        _viewTicketsMode = false;
        _toastMessage = null;
    }

    private void StartChat()
    {
        _viewChatMode = true;
        _chatHistory.Clear();
        _agentSteps.Clear();
        _chatHistory.Add(new GroqChatMessage 
        { 
            Role = "assistant", 
            Content = "Greetings. I am BASTION-Sentinel. As BASTION's active support agent, I have secure access to local tools to inspect logins and configurations. How can I assist you with your fortress configurations today?" 
        });
    }

    private void StartTickets()
    {
        _viewTicketsMode = true;
        _newTicketTitle = string.Empty;
        _newTicketDesc = string.Empty;
    }

    private async Task SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(_userChatMessage)) return;

        var prompt = _userChatMessage.Trim();
        _userChatMessage = string.Empty;
        _chatHistory.Add(new GroqChatMessage { Role = "user", Content = prompt });
        _isChatTyping = true;
        _agentSteps.Clear();

        StateHasChanged();

        try
        {
            // Run the Agentic Reasoning Loop
            var result = await AgentService.ProcessAgenticTaskAsync(prompt, _chatHistory.SkipLast(1).ToList());
            
            _chatHistory.Add(new GroqChatMessage { Role = "assistant", Content = result.Response });
            _agentSteps = result.AgentSteps;
        }
        catch (Exception ex)
        {
            _chatHistory.Add(new GroqChatMessage 
            { 
                Role = "assistant", 
                Content = $"Notice: I encountered an issue invoking the Groq reasoning engine: {ex.Message}. Check your appsettings API keys to activate external loops." 
            });
        }
        finally
        {
            _isChatTyping = false;
            StateHasChanged();
        }
    }

    private async Task HandleChatKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendChatMessage();
        }
    }

    private async Task CreateNewTicketAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTicketTitle) || string.IsNullOrWhiteSpace(_newTicketDesc))
        {
            _toastMessage = "Notice: Title and description are required to dispatch a support ticket.";
            return;
        }

        var currentUserEmail = AuthService.CurrentUser?.Email ?? "guest@bastion.app";
        var title = _newTicketTitle.Trim();
        var desc = _newTicketDesc.Trim();

        _newTicketTitle = string.Empty;
        _newTicketDesc = string.Empty;
        _isTicketSubmitting = true;
        StateHasChanged();

        try
        {
            // 1. Create and save the support ticket to SQLite
            var ticket = new SupportTicket
            {
                Email = currentUserEmail,
                Title = title,
                Description = desc,
                Status = "Open",
                CreatedAt = DateTime.UtcNow
            };

            DbContext.SupportTickets.Add(ticket);
            await DbContext.SaveChangesAsync();

            // 2. Trigger the AI Agent reasoning loop immediately in the background
            var agentResult = await AgentService.ProcessAgenticTaskAsync(
                $"[SUPPORT TICKET SUBMITTED] User Email: {currentUserEmail}. Issue Title: {title}. Details: {desc}", 
                new List<GroqChatMessage>());

            // 3. Update the ticket status & save diagnostic logs
            var dbTicket = await DbContext.SupportTickets.FindAsync(ticket.Id);
            if (dbTicket != null)
            {
                dbTicket.Status = "Resolved";
                
                // Formulate resolution markdown trace
                var mdResolution = $"**Sentinel AI Agent Action Summary:**\n\n{agentResult.Response}\n\n";
                if (agentResult.AgentSteps.Any())
                {
                    mdResolution += "**Diagnostic Traces Checked:**\n";
                    foreach (var step in agentResult.AgentSteps)
                    {
                        mdResolution += $"- *{step}*\n";
                    }
                }
                
                dbTicket.AiResolution = mdResolution;
                await DbContext.SaveChangesAsync();
            }

            _toastMessage = "Support ticket processed, investigated, and successfully resolved by BASTION-Sentinel AI!";
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            _toastMessage = $"Support ticket created, but AI solver encountered an issue: {ex.Message}";
            await LoadTicketsAsync();
        }
        finally
        {
            _isTicketSubmitting = false;
            StateHasChanged();
        }
    }

