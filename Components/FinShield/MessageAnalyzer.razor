    }

    .empty-state h4 {
        margin: 0 0 8px 0;
        color: #e2e8f0;
    }

    .prompt {
        background: rgba(5, 150, 105, 0.1);
        border: 1px solid #059669;
        border-radius: 8px;
        padding: 12px 16px;
        color: #cbd5e1;
        font-size: 14px;
    }
</style>

@code {
    private string messageInput = "";
    private MessageAnalysisData? analysis;
    private bool isAnalyzing = false;
    private string errorMessage = "";

    private class MessageAnalysisData
    {
        public bool HasUrgencyLanguage { get; set; }
        public bool HasBrandImpersonation { get; set; }
        public bool HasPhishingKeywords { get; set; }
        public bool HasOtpHarvesting { get; set; }
        public bool HasSuspiciousLinks { get; set; }
        public string Summary { get; set; } = "";
        public int RiskScore { get; set; }
    }

    private async Task AnalyzeMessage()
    {
        if (string.IsNullOrWhiteSpace(messageInput))
        {
            errorMessage = "Please paste a message to analyze";
            return;
        }

        errorMessage = "";
        isAnalyzing = true;

        try
        {
            await Task.Delay(1500); // Simulate AI analysis

            var message = messageInput.ToLower();
            analysis = new MessageAnalysisData();

            analysis.HasUrgencyLanguage = message.Contains("urgent") || message.Contains("immediately") || 
                                         message.Contains("confirm now") || message.Contains("verify now");
            analysis.HasBrandImpersonation = message.Contains("bank") || message.Contains("amazon") || 
                                            message.Contains("paypal") || message.Contains("apple");
            analysis.HasPhishingKeywords = message.Contains("verify account") || message.Contains("update payment") || 
                                          message.Contains("confirm identity");
            analysis.HasOtpHarvesting = message.Contains("otp") || message.Contains("code") || 
                                       message.Contains("verification code");
            analysis.HasSuspiciousLinks = message.Contains("bit.ly") || message.Contains("tinyurl") || 
                                         message.Contains("http://");

            analysis.RiskScore = (analysis.HasUrgencyLanguage ? 20 : 0) +
                               (analysis.HasBrandImpersonation ? 25 : 0) +
                               (analysis.HasPhishingKeywords ? 25 : 0) +
                               (analysis.HasOtpHarvesting ? 20 : 0) +
                               (analysis.HasSuspiciousLinks ? 10 : 0);

            analysis.Summary = analysis.RiskScore switch
            {
                >= 80 => "This message exhibits multiple phishing indicators and should be treated with extreme caution. Do NOT click any links or enter personal information.",
                >= 50 => "This message contains suspicious elements commonly found in phishing attempts. Verify independently before taking any action.",
                >= 20 => "Minor phishing indicators detected. Proceed with caution and verify any claims independently.",
                _ => "No significant phishing indicators detected, but always stay vigilant."
            };
        }
        catch (Exception ex)
        {
            errorMessage = $"Analysis failed: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private string GetRiskLevel()
    {
        if (analysis?.RiskScore >= 80) return "high";
        if (analysis?.RiskScore >= 50) return "medium";
        return "low";
    }

    private string GetRiskText()
    {
        if (analysis?.RiskScore >= 80) return "🔴 HIGH RISK";
        if (analysis?.RiskScore >= 50) return "🟠 MEDIUM RISK";
        return "🟢 LOW RISK";
    }

    private void ClearAnalysis()
    {
        messageInput = "";
        analysis = null;
        errorMessage = "";
    }

    private void ReportSpam()
    {
        // TODO: Implement spam report functionality
    }
}
