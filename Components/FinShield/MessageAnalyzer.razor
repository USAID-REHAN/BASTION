<div class="message-analyzer">
    <div class="analyzer-card">
        <div class="analyzer-header">
            <h3>💬 Message Analyzer</h3>
            <p class="description">Paste SMS, WhatsApp, or email messages to detect phishing and scam tactics</p>
        </div>

        <div class="message-input-group">
            <textarea 
                class="message-input" 
                @bind="messageInput" 
                placeholder="Paste your message here..."
                disabled="@isAnalyzing"
                rows="6"
            ></textarea>
            <button class="analyze-button @(isAnalyzing ? "loading" : "")" @onclick="AnalyzeMessage" disabled="@isAnalyzing">
                @if (isAnalyzing)
                {
                    <span class="spinner"></span>
                    <span>Analyzing...</span>
                }
                else
                {
                    <span>🔍 Analyze Message</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-error">
                ⚠️ @errorMessage
            </div>
        }

        @if (analysis != null)
        {
            <div class="analysis-result">
                <div class="risk-header @GetRiskLevel()">
                    <div class="risk-title">Risk Assessment</div>
                    <div class="risk-score">@GetRiskText()</div>
                </div>

                <div class="tactics-section">
                    <h4>🚨 Detected Phishing Tactics:</h4>
                    <ul class="tactics-list">
                        @if (analysis.HasUrgencyLanguage) 
                        { 
                            <li class="tactic">⚡ <strong>Urgency Manipulation</strong> - Creates false sense of time pressure</li> 
                        }
                        @if (analysis.HasBrandImpersonation) 
                        { 
                            <li class="tactic">🎭 <strong>Brand Impersonation</strong> - Pretends to be legitimate company</li> 
                        }
                        @if (analysis.HasPhishingKeywords) 
                        { 
                            <li class="tactic">🔓 <strong>Phishing Keywords</strong> - Contains credential harvesting language</li> 
                        }
                        @if (analysis.HasOtpHarvesting) 
                        { 
                            <li class="tactic">🔐 <strong>OTP Harvesting</strong> - Requests verification codes</li> 
                        }
                        @if (analysis.HasSuspiciousLinks) 
                        { 
                            <li class="tactic">🔗 <strong>Suspicious Links</strong> - Contains shortened or masked URLs</li> 
                        }
                        @if (!analysis.HasUrgencyLanguage && !analysis.HasBrandImpersonation && 
                             !analysis.HasPhishingKeywords && !analysis.HasOtpHarvesting && 
                             !analysis.HasSuspiciousLinks)
                        {
                            <li class="tactic clean">✓ No common phishing tactics detected</li>
                        }
                    </ul>
                </div>

                <div class="summary-section">
                    <h4>Summary:</h4>
                    <p>@analysis.Summary</p>
                </div>

                <div class="action-buttons">
                    <button class="btn-secondary" @onclick="ClearAnalysis">Clear</button>
                    <button class="btn-primary" @onclick="ReportSpam">Report as Spam</button>
                </div>
            </div>
        }
        else if (messageInput.Length > 0 && !isAnalyzing)
        {
            <div class="prompt">
                💡 Ready to analyze. Click "Analyze Message" to check for phishing and scam tactics.
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">💬</div>
                <h4>No Message Analyzed Yet</h4>
                <p>Paste a suspicious message above to detect phishing tactics, urgency manipulation, and credential harvesting attempts.</p>
            </div>
        }
    </div>
</div>

<style>
