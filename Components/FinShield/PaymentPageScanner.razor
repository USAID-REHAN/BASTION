</style>

@code {
    [Inject]
    private GroqVisionService? VisionService { get; set; }

    private VisionAnalysisResult? visionResult;
    private bool isAnalyzing = false;
    private bool isDragging = false;
    private string errorMessage = "";
    private string? uploadedFileName;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        await ProcessFile(e.File);
    }

    private async Task HandleDrop(DragEventArgs e)
    {
        isDragging = false;
        // Drag-drop functionality would require JavaScript interop
        // Users can click to select files instead
        await Task.CompletedTask;
    }

    private void HandleDragOver(DragEventArgs e)
    {
        isDragging = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        isDragging = false;
    }

    private async Task ProcessFile(IBrowserFile file)
    {
        try
        {
            if (file.Size > 5 * 1024 * 1024) // 5MB limit
            {
                errorMessage = "File size must be less than 5MB";
                return;
            }

            uploadedFileName = file.Name;
            errorMessage = "";
            isAnalyzing = true;
            visionResult = null;

            var buffer = new byte[file.Size];
            await file.OpenReadStream().ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);

            if (VisionService != null)
            {
                visionResult = await VisionService.AnalyzeImageAsync(base64);
                if (visionResult != null)
                {
                    bool isThreat = visionResult.RiskScore >= 40;
                    SessionState.RecordScan(isThreat);
                    await SavePaymentAnalysis(file.Name, visionResult);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing file: {ex.Message}";
            uploadedFileName = null;
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private string GetRiskClass()
    {
        if (visionResult?.RiskScore >= 70) return "high";
        if (visionResult?.RiskScore >= 40) return "medium";
        return "low";
    }

    private string GetRiskLevel()
    {
        if (visionResult?.RiskScore >= 70) return "🔴 HIGH RISK";
        if (visionResult?.RiskScore >= 40) return "🟠 MEDIUM RISK";
        return "🟢 LOW RISK";
    }

    private void ResetUpload()
    {
        uploadedFileName = null;
        visionResult = null;
        errorMessage = "";
    }

    private void ClearResults()
    {
        visionResult = null;
        uploadedFileName = null;
    }

    private void ReportPhishing()
    {
        // TODO: Implement phishing report functionality
    }

    private async Task SavePaymentAnalysis(string fileName, VisionAnalysisResult result)
    {
        var email = AuthService.CurrentUser?.Email ?? "anonymous";
        DbContext.PaymentPageAnalyses.Add(new BASTION.Models.PaymentPageAnalysis
        {
            Email = email,
            PageUrl = fileName,
            VisionReportSummary = result.Summary,
            RiskScore = result.RiskScore,
            AnomaliesJson = System.Text.Json.JsonSerializer.Serialize(result.Anomalies),
            AnalyzedAt = DateTime.UtcNow
        });
        DbContext.AuditLogs.Add(new BASTION.Models.AuditLog
        {
            Email = email,
            Action = "FinShield Payment Page Scan",
            Timestamp = DateTime.UtcNow,
            Details = $"Analyzed payment screenshot {fileName} with risk score {result.RiskScore}"
        });
        await DbContext.SaveChangesAsync();
    }
}
