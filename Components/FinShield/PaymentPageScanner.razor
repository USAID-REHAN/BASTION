@using BASTION.Services.AI
@inject BASTION.Services.Finance.FinShieldSessionState SessionState
@inject BASTION.Data.BastionDbContext DbContext
@inject BASTION.Services.Auth.AuthService AuthService

<div class="payment-scanner">
    <div class="scanner-card">
        <div class="scanner-header">
            <h3>💳 Payment Page Scanner</h3>
            <p class="description">Upload screenshots to detect phishing and payment fraud</p>
        </div>

        <div class="upload-section">
            <div class="upload-area @(isDragging ? "dragging" : "")" 
                 @ondrop="HandleDrop" 
                 @ondragover="HandleDragOver" 
                 @ondragleave="HandleDragLeave">
                
                @if (!isAnalyzing && uploadedFileName == null)
                {
                    <div class="upload-content">
                        <div class="upload-icon">📷</div>
                        <h4>Upload Payment Page Screenshot</h4>
                        <p>Drag and drop your image here or click to browse</p>
                        <InputFile OnChange="@OnFileSelected" accept="image/*" />
                        <p class="file-info">Supported: JPG, PNG, GIF (max 5MB)</p>
                    </div>
                }
                else if (isAnalyzing)
                {
                    <div class="analyzing">
                        <div class="spinner"></div>
                        <p>🔍 Analyzing image for phishing indicators...</p>
                        <p class="sub-text">This may take a few seconds</p>
                    </div>
                }
                else if (uploadedFileName != null)
                {
                    <div class="uploaded">
                        <div class="checkmark">✓</div>
                        <p>@uploadedFileName</p>
                        <button class="btn-secondary" @onclick="ResetUpload">Choose Another</button>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-error">
                ⚠️ @errorMessage
            </div>
        }

        @if (visionResult != null)
        {
            <div class="result-container">
                <div class="result-header @GetRiskClass()">
                    <div>
                        <h3>Analysis Results</h3>
                        <div class="risk-indicator">
                            Risk Score: <strong>@visionResult.RiskScore%</strong>
                        </div>
                    </div>
                    <div class="risk-level">
                        @GetRiskLevel()
                    </div>
                </div>

                <div class="summary-section">
                    <h4>📋 Summary</h4>
                    <p>@visionResult.Summary</p>
                </div>

                @if (visionResult.Anomalies.Any())
                {
                    <div class="anomalies-section">
                        <h4>🚨 Detected Anomalies</h4>
                        <ul class="anomalies-list">
                            @foreach (var anomaly in visionResult.Anomalies)
                            {
                                <li class="anomaly-item">@anomaly</li>
                            }
                        </ul>
                    </div>
                }

                <div class="action-buttons">
                    <button class="btn-secondary" @onclick="ClearResults">
                        Clear Results
                    </button>
                    <button class="btn-primary" @onclick="ReportPhishing">
                        Report as Phishing
                    </button>
                </div>
            </div>
        }
        else if (!isAnalyzing && uploadedFileName == null)
        {
            <div class="tips-section">
                <h4>💡 What We Check For:</h4>
                <div class="tips-grid">
                    <div class="tip">
                        <div class="tip-icon">🔒</div>
                        <strong>HTTPS Verification</strong>
                        <p>Checks for missing or fake security indicators</p>
                    </div>
                    <div class="tip">
                        <div class="tip-icon">📏</div>
                        <strong>Logo Consistency</strong>
                        <p>Detects stretched or misaligned logos</p>
                    </div>
                    <div class="tip">
                        <div class="tip-icon">🔤</div>
                        <strong>Font Anomalies</strong>
                        <p>Identifies non-standard typography</p>
                    </div>
                    <div class="tip">
                        <div class="tip-icon">📐</div>
                        <strong>Layout Analysis</strong>
                        <p>Compares against legitimate templates</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

