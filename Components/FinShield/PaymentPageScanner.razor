        margin: 0;
        color: #cbd5e1;
        font-weight: 500;
    }

    .btn-secondary {
        padding: 10px 16px;
        background: #334155;
        color: #e2e8f0;
        border: none;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
