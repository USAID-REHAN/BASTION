<div class="scam-feed">
    <div class="feed-container">
        <div class="feed-header">
            <h3>📢 Community Scam Feed</h3>
            <p class="description">Recent scam reports from the community</p>
            <button class="btn-report" @onclick="ShowReportForm">
                📝 Report a Scam
            </button>
        </div>

        <div class="feed-list">
            @foreach (var report in scamReports)
            {
                <div class="feed-item">
                    <div class="report-header">
                        <div class="report-meta">
                            <span class="threat-badge @GetThreatClass(report.ThreatType)">
                                @report.ThreatType
                            </span>
                            <span class="report-date">@report.Date.ToString("MMM d, h:mm tt")</span>
                        </div>
                        <span class="report-count">👍 @report.Reports</span>
                    </div>
                    <h4>@report.Title</h4>
                    <p class="report-description">@report.Description</p>
                    <div class="report-details">
                        @if (!string.IsNullOrEmpty(report.Indicator))
                        {
                            <span class="detail-tag">🔍 @report.Indicator</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (showReportForm)
        {
            <div class="report-form-overlay" @onclick="HideReportForm">
                <div class="report-form" @onclick:stopPropagation="true">
                    <h3>Report a Scam</h3>
                    <div class="form-group">
                        <label>Scam Type</label>
                        <select @bind="newReport.ThreatType">
                            <option value="Phishing">Phishing</option>
                            <option value="Investment">Investment Fraud</option>
                            <option value="Impersonation">Impersonation</option>
                            <option value="Romance">Romance Scam</option>
                            <option value="Tech Support">Tech Support Scam</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Title (Brief Description)</label>
                        <input type="text" @bind="newReport.Title" placeholder="e.g., Fake Amazon order confirmation" />
                    </div>
                    <div class="form-group">
                        <label>Details</label>
                        <textarea @bind="newReport.Description" placeholder="Describe what happened..." rows="4"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Suspicious Indicator (URL, email, number, etc.)</label>
                        <input type="text" @bind="newReport.Indicator" placeholder="e.g., verify-amazon-account.com" />
                    </div>
                    <div class="form-buttons">
                        <button class="btn-cancel" @onclick="HideReportForm">Cancel</button>
                        <button class="btn-submit" @onclick="SubmitReport">Submit Report</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .scam-feed {
        padding: 20px;
    }

    .feed-container {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 24px;
    }

    .feed-header {
        margin-bottom: 24px;
    }

    .feed-header h3 {
        margin: 0 0 8px 0;
        font-size: 20px;
        color: #e2e8f0;
    }

    .description {
        margin: 0 0 16px 0;
        color: #94a3b8;
        font-size: 14px;
    }

    .btn-report {
        padding: 10px 16px;
        background: #059669;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-report:hover {
        background: #047857;
    }

    .feed-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .feed-item {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 16px;
        transition: all 0.3s ease;
    }

    .feed-item:hover {
        border-color: #059669;
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.1);
    }

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .report-meta {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .threat-badge {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .threat-badge.phishing {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
    }

    .threat-badge.investment {
        background: rgba(249, 115, 22, 0.2);
        color: #fdba74;
    }

    .threat-badge.impersonation {
        background: rgba(168, 85, 247, 0.2);
        color: #d8b4fe;
    }

    .threat-badge.romance {
        background: rgba(236, 72, 153, 0.2);
        color: #f472b6;
    }

    .threat-badge.other {
        background: rgba(100, 116, 139, 0.2);
        color: #cbd5e1;
    }

    .report-date {
        color: #64748b;
        font-size: 12px;
    }

    .report-count {
        color: #94a3b8;
        font-size: 13px;
    }

    .feed-item h4 {
        margin: 0 0 8px 0;
        color: #e2e8f0;
        font-size: 14px;
    }

    .report-description {
        margin: 0 0 12px 0;
        color: #cbd5e1;
        font-size: 13px;
        line-height: 1.5;
    }

    .report-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .detail-tag {
        background: rgba(5, 150, 105, 0.1);
        border: 1px solid #059669;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 12px;
        color: #059669;
        word-break: break-all;
    }

    .report-form-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .report-form {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 24px;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }

    .report-form h3 {
        margin: 0 0 20px 0;
        color: #e2e8f0;
        font-size: 18px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #cbd5e1;
        font-size: 13px;
        font-weight: 600;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 10px 12px;
        background: #1e293b;
        border: 1px solid #475569;
        border-radius: 6px;
        color: #e2e8f0;
        font-size: 14px;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    .form-buttons {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .btn-cancel, .btn-submit {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-cancel {
        background: #334155;
        color: #e2e8f0;
    }

    .btn-cancel:hover {
        background: #475569;
    }

    .btn-submit {
        background: #059669;
        color: white;
    }

    .btn-submit:hover {
        background: #047857;
    }
</style>

@code {
    private List<ScamReport> scamReports = new();
    private bool showReportForm = false;
    private ScamReport newReport = new();

    private class ScamReport
    {
        public string ThreatType { get; set; } = "Phishing";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string? Indicator { get; set; }
        public int Reports { get; set; } = 1;
        public DateTime Date { get; set; } = DateTime.Now;
    }

    protected override void OnInitialized()
    {
        LoadSampleReports();
        newReport = new();
    }

    private void LoadSampleReports()
    {
        scamReports = new()
        {
            new()
            {
                ThreatType = "Phishing",
                Title = "Fake Amazon Order Confirmation",
                Description = "Received email claiming to be from Amazon about an unauthorized purchase, requesting account verification.",
                Indicator = "verify-amazon-account.xyz",
                Reports = 47,
                Date = DateTime.Now.AddHours(-2)
            },
            new()
            {
                ThreatType = "Investment",
                Title = "Cryptocurrency Investment Ponzi Scheme",
                Description = "Promised 100% monthly returns on Bitcoin investment through Telegram group. New members were asked to bring more people.",
                Indicator = "+1-555-0123 (WhatsApp)",
                Reports = 23,
                Date = DateTime.Now.AddHours(-4)
            },
            new()
            {
                ThreatType = "Impersonation",
                Title = "Bank Account Verification Scam",
                Description = "SMS claiming to be from bank asking to verify account by clicking link. Link redirects to fake login page.",
                Indicator = "bankverify-app.com",
                Reports = 31,
                Date = DateTime.Now.AddHours(-6)
            },
            new()
            {
                ThreatType = "Romance",
                Title = "Dating App Catfish Asking for Gift Cards",
                Description = "Person on dating app fell in love and requested gift cards for supposed emergency. Never came through.",
                Indicator = "john.smith@gmail.com",
                Reports = 15,
                Date = DateTime.Now.AddHours(-12)
            }
        };
    }

    private string GetThreatClass(string threatType)
    {
        return threatType.ToLower() switch
        {
            "phishing" => "phishing",
            "investment" => "investment",
            "impersonation" => "impersonation",
            "romance" => "romance",
            _ => "other"
        };
    }

    private void ShowReportForm()
    {
        showReportForm = true;
        newReport = new();
    }

    private void HideReportForm()
    {
        showReportForm = false;
    }

    private void SubmitReport()
    {
        if (string.IsNullOrWhiteSpace(newReport.Title))
        {
            return;
        }

        scamReports.Insert(0, newReport);
        HideReportForm();
    }
}
