<div class="hacker-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="hacker-text-glow m-0"><i class="bi bi-terminal"></i> ACTIVE MISSION</h3>
        <button class="btn btn-outline-danger btn-sm fw-bold" @onclick="AbortMission"><i class="bi bi-x-octagon-fill"></i> ABORT MISSION</button>
    </div>
    
    @if (DomainId == 1) { <BASTION.Components.HackerLab.Games.CipherRush OnComplete="HandleComplete" /> }
    else if (DomainId == 2) { <BASTION.Components.HackerLab.Games.NodeBreach OnComplete="HandleComplete" /> }
    else if (DomainId == 3) { <BASTION.Components.HackerLab.Games.FraudFeed OnComplete="HandleComplete" /> }
    else if (DomainId == 4) { <BASTION.Components.HackerLab.Games.DataLeaker OnComplete="HandleComplete" /> }
    else if (DomainId == 5) { <BASTION.Components.HackerLab.Games.FirewallMaze OnComplete="HandleComplete" /> }
</div>

@code {
    [Parameter] public int DomainId { get; set; }
    [Parameter] public EventCallback<GameResult> OnComplete { get; set; }

    private void HandleComplete(GameResult result)
    {
        OnComplete.InvokeAsync(result);
    }
    
    private void AbortMission()
    {
        OnComplete.InvokeAsync(new GameResult { Aborted = true });
    }
}
