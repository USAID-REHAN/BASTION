@inherits LayoutComponentBase
@implements IDisposable
@inject BASTION.Services.Auth.AuthService AuthService
@inject BASTION.Services.Auth.AdminService AdminService
@inject BASTION.Services.Theme.ThemeService ThemeService
@inject BASTION.Services.Sound.SoundService SoundService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!AuthService.IsAuthenticated)
{
    <!-- No layout for auth pages — GateKeeper handles its own full-page layout -->
    @Body
}
else if (AdminService.GetSystemConfig().TryGetValue("MaintenanceMode", out var mode) && mode == "True" && !AuthService.IsAdmin)
{
    <div class="maintenance-container" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; background: #0f172a; color: #ffffff; font-family: 'Inter', sans-serif; text-align: center; padding: 40px 20px; overflow: hidden; position: relative;">
        <!-- Cyber grid background -->
        <div style="position: absolute; inset: 0; background-image: radial-gradient(rgba(239, 68, 68, 0.05) 1px, transparent 0), radial-gradient(rgba(239, 68, 68, 0.05) 1px, transparent 0); background-size: 24px 24px; background-position: 0 0, 12px 12px; pointer-events: none; opacity: 0.5;"></div>
        
        <!-- Premium glass construction card -->
        <div style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 16px; padding: 48px; max-width: 550px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5); position: relative; z-index: 10;">
            <div class="maintenance-icon" style="width: 80px; height: 80px; background: rgba(239, 68, 68, 0.1); border: 2px solid #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; box-shadow: 0 0 30px rgba(239, 68, 68, 0.3); animation: pulse 2s infinite;">
                <i class="bi bi-cone-striped" style="font-size: 2.5rem; color: #ef4444;"></i>
            </div>
            
            <h1 style="font-size: 1.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #ffffff; margin: 0 0 16px;">BASTION Under Maintenance</h1>
            <div style="height: 4px; width: 60px; background: #ef4444; margin: 0 auto 24px; border-radius: 2px;"></div>
            
            <p style="font-size: 0.95rem; color: #94a3b8; line-height: 1.7; margin-bottom: 32px;">
                Our cybersecurity fortress is currently undergoing planned system optimization and structural defense upgrades to ensure absolute protection. We will return online shortly.
            </p>
            
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                    <span style="color: #64748b; font-weight: 500;">Status</span>
                    <span style="color: #ef4444; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                        <span style="width: 8px; height: 8px; background: #ef4444; border-radius: 50%; display: inline-block;"></span>
                        UPGRADING SHIELDS
                    </span>
                </div>
                
                <button class="btn-gate btn-gate-primary" @onclick="Logout" style="width: 100%; justify-content: center; background: #ef4444; border-color: #ef4444; box-shadow: 0 4px 14px rgba(239, 68, 68, 0.3); font-weight: 600;">
                    <i class="bi bi-box-arrow-right"></i> Sign Out
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="bastion-app">
        <div class="bastion-layout">
            <!-- Sidebar -->
            <Sidebar IsCollapsed="@_sidebarCollapsed" OnToggle="@ToggleSidebar" />

            <!-- Main Content -->
            <main class="bastion-main @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
                @if (AuthService.IsAdmin)
                {
                    <div class="admin-banner">
                        <i class="bi bi-shield-exclamation"></i>
                        ADMIN MODE — You have elevated privileges
                    </div>
                }

                <!-- Top Bar -->
                <header class="bastion-topbar">
                    <div class="topbar-left" style="display: flex; align-items: center;">
                        <button class="topbar-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
                            <i class="bi bi-list"></i>
                        </button>
                        <a href="/about" style="color: var(--text-current); text-decoration: none; margin-left: 15px; font-size: 0.9rem; opacity: 0.8; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'">About</a>
                        <a href="/support" style="color: var(--text-current); text-decoration: none; margin-left: 15px; font-size: 0.9rem; opacity: 0.8; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'">Support</a>
                    </div>
                    <div class="topbar-right">
                        <!-- Theme Toggle -->
                        <button class="topbar-btn" @onclick="ToggleTheme" title="@(ThemeService.IsDarkMode ? "Switch to Light" : "Switch to Dark")">
                            <i class="bi @(ThemeService.IsDarkMode ? "bi-sun" : "bi-moon-stars")"></i>
                        </button>

                        <!-- Sound Toggle -->
                        <button class="topbar-btn" @onclick="ToggleSound" title="@(SoundService.IsSoundEnabled ? "Mute" : "Unmute")">
                            <i class="bi @(SoundService.IsSoundEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>

                        <!-- User Menu -->
                        <div class="topbar-user" @onclick="() => _showUserMenu = !_showUserMenu">
                            <div class="topbar-avatar">
                                @AuthService.CurrentUser?.FullName?.Substring(0, 1).ToUpper()
                            </div>
                            <span class="topbar-username">@AuthService.CurrentUser?.FullName</span>
                            <i class="bi bi-chevron-down" style="font-size: 0.7rem;"></i>
                        </div>

                        @if (_showUserMenu)
                        {
                            <div class="topbar-dropdown">
                                <a href="/settings" class="topbar-dropdown-item" @onclick="() => _showUserMenu = false">
                                    <i class="bi bi-gear"></i> Settings
                                </a>
                                <button class="topbar-dropdown-item" @onclick="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </button>
                            </div>
                        }
                    </div>
                </header>

                <!-- Page Content -->
                <div class="bastion-content">
                    @Body
                </div>
            </main>
        </div>
    </div>
}

<!-- Toast Container -->
<div class="toast-container" id="toast-container"></div>

@code {
    private bool _sidebarCollapsed;
    private bool _showUserMenu;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await ThemeService.InitializeAsync();
            await SoundService.InitializeAsync();
            ThemeService.OnThemeChanged += OnThemeChanged;
            SoundService.OnSoundStateChanged += OnSoundChanged;
            AuthService.OnAuthStateChanged += OnAuthStateChanged;
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme() => await ThemeService.ToggleTheme();
    private async Task ToggleSound() => await SoundService.ToggleSound();
    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    private void Logout()
    {
        _showUserMenu = false;
        AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    private void OnSoundChanged() => InvokeAsync(StateHasChanged);
    
    private void OnAuthStateChanged()
    {
        InvokeAsync(() => {
            if (!AuthService.IsAuthenticated)
            {
                Navigation.NavigateTo($"/login?reason={AuthService.LastSignOutReason}", forceLoad: true);
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        SoundService.OnSoundStateChanged -= OnSoundChanged;
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }
}
