@inherits LayoutComponentBase
@implements IDisposable
@inject BASTION.Services.Auth.AuthService AuthService
@inject BASTION.Services.Theme.ThemeService ThemeService
@inject BASTION.Services.Sound.SoundService SoundService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!AuthService.IsAuthenticated)
{
    <!-- No layout for auth pages — GateKeeper handles its own full-page layout -->
    @Body
}
else
{
    <div class="bastion-app">
        <div class="bastion-layout">
            <!-- Sidebar -->
            <Sidebar IsCollapsed="@_sidebarCollapsed" OnToggle="@ToggleSidebar" />

            <!-- Main Content -->
            <main class="bastion-main @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
                @if (AuthService.IsAdmin)
                {
                    <div class="admin-banner">
                        <i class="bi bi-shield-exclamation"></i>
                        ADMIN MODE — You have elevated privileges
                    </div>
                }

                <!-- Top Bar -->
                <header class="bastion-topbar">
                    <button class="topbar-toggle" @onclick="ToggleSidebar">
                        <i class="bi @(_sidebarCollapsed ? "bi-list" : "bi-x-lg")"></i>
                    </button>

                    <div class="topbar-right">
                        <!-- Theme Toggle -->
                        <button class="topbar-btn" @onclick="ToggleTheme" title="@(ThemeService.IsDarkMode ? "Switch to Light" : "Switch to Dark")">
                            <i class="bi @(ThemeService.IsDarkMode ? "bi-sun" : "bi-moon-stars")"></i>
                        </button>

                        <!-- Sound Toggle -->
                        <button class="topbar-btn" @onclick="ToggleSound" title="@(SoundService.IsSoundEnabled ? "Mute" : "Unmute")">
                            <i class="bi @(SoundService.IsSoundEnabled ? "bi-volume-up" : "bi-volume-mute")"></i>
                        </button>

                        <!-- User Menu -->
                        <div class="topbar-user" @onclick="() => _showUserMenu = !_showUserMenu">
                            <div class="topbar-avatar">
                                @AuthService.CurrentUser?.FullName?.Substring(0, 1).ToUpper()
                            </div>
                            <span class="topbar-username">@AuthService.CurrentUser?.FullName</span>
                            <i class="bi bi-chevron-down" style="font-size: 0.7rem;"></i>
                        </div>

                        @if (_showUserMenu)
                        {
                            <div class="topbar-dropdown">
                                <a href="/settings" class="topbar-dropdown-item" @onclick="() => _showUserMenu = false">
                                    <i class="bi bi-gear"></i> Settings
                                </a>
                                <button class="topbar-dropdown-item" @onclick="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </button>
                            </div>
                        }
                    </div>
                </header>

                <!-- Page Content -->
                <div class="bastion-content">
                    @Body
                </div>
            </main>
        </div>
    </div>
}

<!-- Toast Container -->
<div class="toast-container" id="toast-container"></div>

@code {
    private bool _sidebarCollapsed;
    private bool _showUserMenu;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            await ThemeService.InitializeAsync();
            await SoundService.InitializeAsync();
            ThemeService.OnThemeChanged += OnThemeChanged;
            SoundService.OnSoundStateChanged += OnSoundChanged;
            AuthService.OnAuthStateChanged += OnAuthStateChanged;
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme() => await ThemeService.ToggleTheme();
    private async Task ToggleSound() => await SoundService.ToggleSound();
    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    private void Logout()
    {
        _showUserMenu = false;
        AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    private void OnSoundChanged() => InvokeAsync(StateHasChanged);
    
    private void OnAuthStateChanged()
    {
        InvokeAsync(() => {
            if (!AuthService.IsAuthenticated)
            {
                Navigation.NavigateTo("/login?reason=revoked", forceLoad: true);
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        SoundService.OnSoundStateChanged -= OnSoundChanged;
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }
}
