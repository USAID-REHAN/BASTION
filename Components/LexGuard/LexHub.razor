    private async Task OnCompareFileASelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _compareFileNameA = file.Name;
        _compareError = "";
        StateHasChanged();
        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            var extension = Path.GetExtension(file.Name).ToLower();
            if (extension == ".pdf")
            {
                _compareTextA = AnalysisService.ExtractTextFromPdf(stream);
            }
            else if (extension == ".docx")
            {
                _compareTextA = AnalysisService.ExtractTextFromDocx(stream);
            }
            else
            {
                _compareError = "Unsupported file type for Version A. Please upload PDF or DOCX.";
                _compareFileNameA = "";
            }
        }
        catch (Exception ex)
        {
            _compareError = $"Error reading Version A: {ex.Message}";
            _compareFileNameA = "";
        }
        StateHasChanged();
    }

