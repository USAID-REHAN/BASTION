@page "/lexguard"
@rendermode InteractiveServer
@using BASTION.Models
@using BASTION.Components.LexGuard
@inject BASTION.Services.Legal.DocumentAnalysisService AnalysisService
@inject BASTION.Services.Legal.PdfReportService PdfService
@inject BASTION.Services.Auth.AuthService AuthService
@inject BASTION.Data.BastionDbContext Db
@inject IJSRuntime JS

<PageTitle>BASTION — LexGuard</PageTitle>

<div class="lex-page">
    <div class="lex-page-header">
        <div class="lex-icon">
            <i class="bi bi-file-earmark-text"></i>
        </div>
        <div>
            <h1>LexGuard</h1>
            <p style="color: var(--text-muted); margin: 4px 0 0 0; font-size: 0.9rem;">AI-Powered Legal Document Protection</p>
        </div>
    </div>

    <!-- Tabs -->
    <div class="lex-tabs">
        <button class="lex-tab @(_activeTab == "analyze" ? "active" : "")"
                @onclick='() => SwitchTab("analyze")'>
            <i class="bi bi-search"></i> Analyze
        </button>
        <button class="lex-tab @(_activeTab == "compare" ? "active" : "")"
                @onclick='() => SwitchTab("compare")'>
            <i class="bi bi-file-diff"></i> Compare
        </button>
        <button class="lex-tab @(_activeTab == "audit" ? "active" : "")"
                @onclick='() => SwitchTab("audit")'>
            <i class="bi bi-shield-check"></i> Audit
        </button>
        <button class="lex-tab @(_activeTab == "draft" ? "active" : "")"
                @onclick='() => SwitchTab("draft")'>
            <i class="bi bi-pen"></i> Smart Drafter
        </button>
        <button class="lex-tab @(_activeTab == "history" ? "active" : "")"
                @onclick='() => SwitchTab("history")'>
            <i class="bi bi-clock-history"></i> History
            @if (_historyCount > 0)
            {
                <span class="badge-bastion badge-info" style="font-size: 0.65rem;">@_historyCount</span>
            }
        </button>
    </div>

    @* ═══════════ ANALYZE TAB ═══════════ *@
    @if (_activeTab == "analyze")
    {
        @if (_state == PageState.Upload)
        {
            <DocumentUploader OnFileUploaded="HandleFileUpload" />
        }
        else if (_state == PageState.Processing)
        {
            <div class="lex-processing">
                <div class="lex-processing-spinner"></div>
                <h3>Analyzing your document...</h3>
                <p>LexGuard AI is reviewing clauses, obligations, and risks</p>
                <p style="margin-top: 8px; font-size: 0.8rem; color: var(--text-muted);">
                    <i class="bi bi-file-text"></i> @_currentFileName
                </p>
            </div>
        }
        else if (_state == PageState.Error)
        {
            <div class="lex-error">
                <i class="bi bi-exclamation-triangle"></i>
                <div>
                    <strong>Analysis Failed</strong>
                    <p style="margin-top: 4px;">@_errorMessage</p>
                </div>
            </div>
            <div style="margin-top: 16px;">
                <button class="btn-lex btn-lex-primary" @onclick="ResetToUpload">
                    <i class="bi bi-arrow-clockwise"></i> Try Again
                </button>
            </div>
        }
        else if (_state == PageState.Results && _currentResult != null)
        {
            <div class="lex-results" id="lex-results">
                <!-- Results Header -->
                <div class="lex-results-header">
                    <div class="doc-info">
                        <i class="bi @(_currentFileType == "pdf" ? "bi-file-earmark-pdf" : "bi-file-earmark-word")"
                           style="font-size: 1.5rem; color: #D97706;"></i>
                        <div>
                            <div class="doc-name">@_currentFileName</div>
                            <div class="doc-meta">
                                @_currentFileType.ToUpper() · @FormatSize(_currentFileSize)
                                · Analyzed @_currentAnalyzedAt.ToString("dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                    </div>
                    <div class="lex-results-actions">
                        <button class="btn-lex btn-lex-primary" @onclick="DownloadPdfReport" disabled="@_isGeneratingPdf">
                            @if (_isGeneratingPdf)
                            {
                                <span class="lex-processing-spinner" style="width:16px;height:16px;border-width:2px;margin:0;"></span>
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-pdf"></i>
                            }
                            Generate PDF Report
                        </button>
                        <button class="btn-lex btn-lex-ghost" @onclick="ResetToUpload">
                            <i class="bi bi-plus-circle"></i> New Analysis
                        </button>
                    </div>
                </div>

                <!-- Stats Row -->
                <div class="lex-stats-row">
                    <div class="lex-stat">
                        <div class="lex-stat-value">@_currentResult.Clauses.Count</div>
                        <div class="lex-stat-label">Clauses Found</div>
                    </div>
                    <div class="lex-stat">
                        <div class="lex-stat-value" style="color: #EF4444;">
                            @_currentResult.Clauses.Count(c => c.RiskLevel.ToLower() == "danger")
                        </div>
                        <div class="lex-stat-label">Danger Flags</div>
                    </div>
                    <div class="lex-stat">
                        <div class="lex-stat-value" style="color: #F59E0B;">
                            @_currentResult.Obligations.Count
                        </div>
                        <div class="lex-stat-label">Obligations</div>
                    </div>
                    <div class="lex-stat">
                        <div class="lex-stat-value" style="color: #3B82F6;">
                            @_currentResult.MissingClauses.Count
                        </div>
                        <div class="lex-stat-label">Missing Clauses</div>
                    </div>
                </div>

                <!-- Summary + Risk Gauge -->
                <div class="lex-card">
                    <div class="lex-card-title">
                        <i class="bi bi-card-text"></i> Executive Summary
                    </div>
                    <div class="lex-summary-grid">
                        <RiskScoreGauge Score="@_currentResult.RiskScore"
                                        RiskLevel="@_currentResult.OverallRiskLevel" />
                        <div class="lex-summary-text">
                            @_currentResult.Summary
                        </div>
                    </div>
                </div>

                <!-- Clause Analysis -->
                <div class="lex-card">
                    <div class="lex-card-title">
                        <i class="bi bi-list-check"></i> Clause-by-Clause Analysis
                        <span style="margin-left: auto; font-size: 0.8rem; font-weight: 400; color: var(--text-muted);">
                            Click to expand
                        </span>
                    </div>
                    <ClauseHighlighter Clauses="@_currentResult.Clauses" />
                </div>

                <!-- Obligations Timeline -->
                @if (_currentResult.Obligations.Any())
                {
                    <div class="lex-card">
                        <div class="lex-card-title">
                            <i class="bi bi-calendar-event"></i> Obligations & Deadlines
                        </div>
                        <ObligationTimeline Obligations="@_currentResult.Obligations" />
                    </div>
                }

                <!-- Missing Clauses -->
                @if (_currentResult.MissingClauses.Any())
                {
                    <div class="lex-card">
                        <div class="lex-card-title">
                            <i class="bi bi-shield-exclamation"></i> Missing Protective Clauses
                        </div>
                        <div class="lex-missing-list">
                            @foreach (var missing in _currentResult.MissingClauses)
                            {
                                <div class="lex-missing-item @missing.Importance.ToLower()">
                                    <div class="lex-missing-dot"></div>
                                    <div>
                                        <div class="lex-missing-title">
                                            @missing.Title
                                            <span class="lex-missing-importance">@missing.Importance.ToUpper()</span>
                                        </div>
                                        <div class="lex-missing-explanation">@missing.Explanation</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Document Q&A Chat -->
                @if (!string.IsNullOrEmpty(_currentRawText))
                {
                    <div class="lex-card" id="chat-section">
                        <div class="lex-card-title">
                            <i class="bi bi-chat-dots"></i> Chat with Document
                        </div>
                        <div class="lex-chat-container" style="background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px solid var(--border-current); padding: 16px; display: flex; flex-direction: column; gap: 12px;">
                            <div style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-right: 8px;">
                                @if (!_chatHistory.Any())
                                {
                                    <div style="color: var(--text-muted); font-size: 0.9rem; font-style: italic; text-align: center; padding: 20px;">
                                        Ask LexGuard any question about this document...
                                    </div>
                                }
                                @foreach (var msg in _chatHistory)
                                {
                                    <div style="align-self: @(msg.Role == "user" ? "flex-end" : "flex-start"); background: @(msg.Role == "user" ? "rgba(65, 88, 208, 0.2)" : "rgba(255,255,255,0.05)"); border: 1px solid @(msg.Role == "user" ? "rgba(65, 88, 208, 0.4)" : "rgba(255,255,255,0.1)"); padding: 10px 14px; border-radius: 12px; max-width: 85%; font-size: 0.9rem;">
                                        @msg.Content
                                    </div>
                                }
                            </div>
                            <div style="display: flex; gap: 8px;">
                                <input type="text" class="gate-input" style="flex: 1; margin: 0;" placeholder="e.g., Are there any hidden fees?" @bind="_currentQuestion" @bind:event="oninput" @onkeyup="HandleChatKey" disabled="@_isChatting" />
                                <button class="btn-lex btn-lex-primary" style="padding: 0 16px;" @onclick="SendChatMessage" disabled="@(_isChatting || string.IsNullOrWhiteSpace(_currentQuestion))">
                                    @if (_isChatting) { <span class="lex-processing-spinner" style="width:14px;height:14px;border-width:2px;margin:0;"></span> } else { <i class="bi bi-send"></i> }
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_chatError))
                            {
                                <div style="color: #EF4444; font-size: 0.8rem; margin-top: 4px;">@_chatError</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* ═══════════ DRAFT TAB ═══════════ *@
    @if (_activeTab == "draft")
    {
        <div class="lex-card">
            <div class="lex-card-title">
                <i class="bi bi-pen"></i> AI Smart Legal Drafter
            </div>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                Describe the contract or legal document you need. LexGuard will instantly generate a comprehensive, legally sound draft for you to review and copy.
            </p>

            <div style="display: flex; flex-direction: column; gap: 16px;">
                <textarea class="gate-input" style="min-height: 120px; resize: vertical;"
                          placeholder="e.g., 'I need an NDA for a freelance software developer in California. It should include a 2-year non-compete and a $50,000 penalty for data breaches.'"
                          @bind="_draftPrompt"></textarea>

                <button class="btn-lex btn-lex-primary" @onclick="GenerateDraft" disabled="@(_isDrafting || string.IsNullOrWhiteSpace(_draftPrompt))">
                    @if (_isDrafting)
                    {
                        <span class="lex-processing-spinner" style="width:16px;height:16px;border-width:2px;margin:0;"></span>
                        <span>Drafting...</span>
                    }
                    else
                    {
                        <i class="bi bi-magic"></i> <span>Generate Document</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_draftResult))
            {
                <div style="margin-top: 32px; border-top: 1px solid var(--border-current); padding-top: 24px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <h3 style="margin: 0; font-size: 1.2rem;">Generated Draft</h3>
                        <div style="display: flex; gap: 8px;">
                            <button class="btn-lex btn-lex-primary" @onclick="DownloadDraftPdf" style="font-size: 0.8rem; padding: 4px 12px;" disabled="@_isGeneratingDraftPdf">
                                @if (_isGeneratingDraftPdf) { <span class="lex-processing-spinner" style="width:12px;height:12px;border-width:2px;margin:0;"></span> } else { <i class="bi bi-file-earmark-pdf"></i> } Download PDF
                            </button>
                            <button class="btn-lex btn-lex-ghost" @onclick="CopyDraft" style="font-size: 0.8rem; padding: 4px 12px;">
                                <i class="bi bi-clipboard"></i> Copy to Clipboard
                            </button>
                        </div>
                    </div>
                    <div style="background: rgba(0,0,0,0.2); padding: 20px; border-radius: 12px; border: 1px solid var(--border-current); font-family: monospace; font-size: 0.9rem; white-space: pre-wrap; color: var(--text-current); max-height: 500px; overflow-y: auto;">
                        @_draftResult
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_draftError))
            {
                <div class="lex-error" style="margin-top: 20px;">
                    <i class="bi bi-exclamation-triangle"></i> @_draftError
                </div>
            }
        </div>
    }

    @* ═══════════ COMPARE TAB ═══════════ *@
    @if (_activeTab == "compare")
    {
        <div class="lex-card">
            <div class="lex-card-title">
                <i class="bi bi-file-diff"></i> AI Document Comparison
            </div>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                Upload two versions of a document to instantly analyze the legal implications of the changes.
            </p>
            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 8px; background: rgba(255, 255, 255, 0.02); border: 1px dashed var(--border-current); padding: 20px; border-radius: 12px; text-align: center; justify-content: center; min-height: 150px; transition: all 0.3s ease;">
                    <div style="font-size: 2rem; color: #D97706;"><i class="bi bi-file-earmark-arrow-up"></i></div>
                    <label style="font-weight: 600; font-size: 0.95rem; color: var(--text-current);">Version A (Original PDF/DOCX)</label>
                    <div style="position: relative; overflow: hidden; display: inline-block; margin: 8px auto;">
                        <InputFile OnChange="OnCompareFileASelected" accept=".pdf,.docx" style="font-size: 0.85rem; color: var(--text-muted); background: rgba(0,0,0,0.2); border: 1px solid var(--border-current); padding: 8px 12px; border-radius: 6px; cursor: pointer;" />
                    </div>
                    @if (!string.IsNullOrEmpty(_compareFileNameA))
                    {
                        <div style="font-size: 0.85rem; color: #34D399; margin-top: 4px; word-break: break-all;"><i class="bi bi-check-circle-fill"></i> Loaded: @_compareFileNameA</div>
                    }
                </div>
                <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 8px; background: rgba(255, 255, 255, 0.02); border: 1px dashed var(--border-current); padding: 20px; border-radius: 12px; text-align: center; justify-content: center; min-height: 150px; transition: all 0.3s ease;">
                    <div style="font-size: 2rem; color: #D97706;"><i class="bi bi-file-earmark-arrow-up"></i></div>
                    <label style="font-weight: 600; font-size: 0.95rem; color: var(--text-current);">Version B (Modified PDF/DOCX)</label>
                    <div style="position: relative; overflow: hidden; display: inline-block; margin: 8px auto;">
                        <InputFile OnChange="OnCompareFileBSelected" accept=".pdf,.docx" style="font-size: 0.85rem; color: var(--text-muted); background: rgba(0,0,0,0.2); border: 1px solid var(--border-current); padding: 8px 12px; border-radius: 6px; cursor: pointer;" />
                    </div>
                    @if (!string.IsNullOrEmpty(_compareFileNameB))
                    {
                        <div style="font-size: 0.85rem; color: #34D399; margin-top: 4px; word-break: break-all;"><i class="bi bi-check-circle-fill"></i> Loaded: @_compareFileNameB</div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_compareTextA) || !string.IsNullOrEmpty(_compareTextB))
            {
                <div style="display: flex; gap: 16px; margin-top: 20px; flex-wrap: wrap;">
                    @if (!string.IsNullOrEmpty(_compareTextA))
                    {
                        <div style="flex: 1; min-width: 200px; display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">Version A Extracted Preview:</label>
                            <textarea class="gate-input" style="min-height: 100px; font-size: 0.8rem; background: rgba(0,0,0,0.15);" readonly>@(_compareTextA.Length > 2000 ? _compareTextA[..2000] + "\n...[truncated preview]" : _compareTextA)</textarea>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_compareTextB))
                    {
                        <div style="flex: 1; min-width: 200px; display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">Version B Extracted Preview:</label>
                            <textarea class="gate-input" style="min-height: 100px; font-size: 0.8rem; background: rgba(0,0,0,0.15);" readonly>@(_compareTextB.Length > 2000 ? _compareTextB[..2000] + "\n...[truncated preview]" : _compareTextB)</textarea>
                        </div>
                    }
                </div>
            }

            <button class="btn-lex btn-lex-primary" style="margin-top: 20px;" @onclick="CompareDocuments" disabled="@(_isComparing || string.IsNullOrWhiteSpace(_compareTextA) || string.IsNullOrWhiteSpace(_compareTextB))">
                @if (_isComparing) { <span class="lex-processing-spinner" style="width:16px;height:16px;border-width:2px;margin:0;"></span> } else { <i class="bi bi-magic"></i> } Compare Documents
            </button>
            
            @if (!string.IsNullOrEmpty(_compareResult))
            {
                <div style="margin-top: 32px; border-top: 1px solid var(--border-current); padding-top: 24px;">
                    <h3 style="margin: 0 0 16px 0; font-size: 1.2rem;">Comparison Results</h3>
                    <div style="background: rgba(0,0,0,0.2); padding: 20px; border-radius: 12px; border: 1px solid var(--border-current); font-family: monospace; font-size: 0.9rem; white-space: pre-wrap; color: var(--text-current); max-height: 500px; overflow-y: auto;">
                        @_compareResult
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_compareError))
            {
                <div class="lex-error" style="margin-top: 20px;">
                    <i class="bi bi-exclamation-triangle"></i> @_compareError
                </div>
            }
        </div>
    }

    @* ═══════════ AUDIT TAB ═══════════ *@
    @if (_activeTab == "audit")
    {
        <div class="lex-card">
            <div class="lex-card-title">
                <i class="bi bi-shield-check"></i> Compliance Auditor
            </div>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
                Upload a document to strictly audit it for compliance against standard regulatory frameworks.
            </p>
            <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <label style="font-weight: 500; font-size: 0.9rem;">Framework:</label>
                    <select class="gate-input" style="width: 200px; margin: 0;" @bind="_auditFramework">
                        <option value="GDPR">GDPR (Europe)</option>
                        <option value="CCPA">CCPA (California)</option>
                        <option value="HIPAA">HIPAA (Healthcare)</option>
                        <option value="PCI-DSS">PCI-DSS (Payments)</option>
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(_currentRawText))
                {
                    <button class="btn-lex btn-lex-ghost" @onclick="LoadAnalyzerTextForAudit" style="font-size: 0.8rem; padding: 4px 12px;">
                        <i class="bi bi-box-arrow-in-down"></i> Load Analyzed Document
                    </button>
                }
            </div>

            <div style="margin-top: 20px; background: rgba(255, 255, 255, 0.02); border: 1px dashed var(--border-current); padding: 24px; border-radius: 12px; text-align: center; display: flex; flex-direction: column; gap: 8px; align-items: center; justify-content: center; min-height: 150px; transition: all 0.3s ease;">
                <div style="font-size: 2.5rem; color: #D97706;"><i class="bi bi-file-earmark-shield"></i></div>
                <label style="font-weight: 600; font-size: 0.95rem; color: var(--text-current);">Upload Document to Audit (PDF/DOCX)</label>
                <div style="position: relative; overflow: hidden; display: inline-block; margin: 8px auto;">
                    <InputFile OnChange="OnAuditFileSelected" accept=".pdf,.docx" style="font-size: 0.85rem; color: var(--text-muted); background: rgba(0,0,0,0.2); border: 1px solid var(--border-current); padding: 8px 12px; border-radius: 6px; cursor: pointer;" />
                </div>
                @if (!string.IsNullOrEmpty(_auditFileName))
                {
                    <div style="font-size: 0.85rem; color: #34D399; margin-top: 4px; word-break: break-all;"><i class="bi bi-check-circle-fill"></i> Loaded: @_auditFileName</div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_auditText))
            {
                <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 20px;">
                    <label style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">Extracted Preview:</label>
                    <textarea class="gate-input" style="min-height: 120px; font-size: 0.8rem; background: rgba(0,0,0,0.15);" readonly>@(_auditText.Length > 2000 ? _auditText[..2000] + "\n...[truncated preview]" : _auditText)</textarea>
                </div>
            }
            
            <button class="btn-lex btn-lex-primary" style="margin-top: 20px;" @onclick="AuditCompliance" disabled="@(_isAuditing || string.IsNullOrWhiteSpace(_auditText))">
                @if (_isAuditing) { <span class="lex-processing-spinner" style="width:16px;height:16px;border-width:2px;margin:0;"></span> } else { <i class="bi bi-shield-check"></i> } Run Audit
            </button>
            
            @if (!string.IsNullOrEmpty(_auditResult))
            {
                <div style="margin-top: 32px; border-top: 1px solid var(--border-current); padding-top: 24px;">
                    <h3 style="margin: 0 0 16px 0; font-size: 1.2rem;">Audit Report</h3>
                    <div style="background: rgba(0,0,0,0.2); padding: 20px; border-radius: 12px; border: 1px solid var(--border-current); font-family: monospace; font-size: 0.9rem; white-space: pre-wrap; color: var(--text-current); max-height: 500px; overflow-y: auto;">
                        @_auditResult
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_auditError))
            {
                <div class="lex-error" style="margin-top: 20px;">
                    <i class="bi bi-exclamation-triangle"></i> @_auditError
                </div>
            }
        </div>
    }

    @* ═══════════ HISTORY TAB ═══════════ *@
    @if (_activeTab == "history")
    {
        <AnalysisHistory Analyses="@_historyList"
                         OnViewAnalysis="ViewHistoricalAnalysis"
                         OnDownloadPdf="DownloadHistoricalPdf"
                         OnDeleteAnalysis="DeleteAnalysis" />
    }
</div>

@code {
    private enum PageState { Upload, Processing, Results, Error }

    private string _activeTab = "analyze";
    private PageState _state = PageState.Upload;
    private string? _errorMessage;
    private bool _isGeneratingPdf;

    // Drafter state
    private string _draftPrompt = "";
    private string _draftResult = "";
    private string _draftError = "";
    private bool _isDrafting;

    // Current analysis
    private AnalysisResult? _currentResult;
    private string _currentFileName = string.Empty;
    private string _currentFileType = string.Empty;
    private string _currentRawText = string.Empty;
    private long _currentFileSize;
    private DateTime _currentAnalyzedAt;
    private int? _currentRecordId;

    // Chat State
    private string _currentQuestion = "";
    private bool _isChatting;
    private string _chatError = "";
    private List<(string Role, string Content)> _chatHistory = new();
    private bool _isGeneratingDraftPdf;

    // Compare State
    private string _compareFileNameA = "";
    private string _compareFileNameB = "";
    private string _compareTextA = "";
    private string _compareTextB = "";
    private string _compareResult = "";
    private string _compareError = "";
    private bool _isComparing;

    // Audit State
    private string _auditFileName = "";
    private string _auditText = "";
    private string _auditFramework = "GDPR";
    private string _auditResult = "";
    private string _auditError = "";
    private bool _isAuditing;

    // History
    private List<LexGuardAnalysis> _historyList = new();
    private int _historyCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
