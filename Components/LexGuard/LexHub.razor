    private string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    // ── Drafting ──

    private async Task GenerateDraft()
    {
        if (string.IsNullOrWhiteSpace(_draftPrompt)) return;
        
        _isDrafting = true;
        _draftResult = "";
        _draftError = "";
        StateHasChanged();

        try
        {
            _draftResult = await AnalysisService.DraftContractAsync(_draftPrompt);
            
            // ── Persist Draft into History ──
            var userId = AuthService.CurrentUser?.Email ?? "anonymous";
            var documentName = GetDraftName(_draftPrompt, _draftResult);
            
            var record = new LexGuardAnalysis
            {
                UserId = userId,
                DocumentName = documentName,
                DocumentType = "draft",
                DocumentSizeBytes = System.Text.Encoding.UTF8.GetByteCount(_draftResult),
                AnalyzedAt = DateTime.UtcNow,
                RiskScore = 0,
                RiskLevel = "safe",
                Summary = _draftResult,
                ClausesJson = _draftPrompt, // Store the user prompt in ClausesJson to restore on click
                ObligationsJson = "[]",
                MissingClausesJson = "[]"
            };

            Db.LexGuardAnalyses.Add(record);
            Db.AuditLogs.Add(new BASTION.Models.AuditLog
            {
                Email = userId,
                Action = "LexGuard Draft Created",
                Timestamp = DateTime.UtcNow,
                Details = $"Created draft {documentName}"
            });
            await Db.SaveChangesAsync();
            await LoadHistory(); // Refresh history immediately
        }
        catch (Exception ex)
        {
            _draftError = $"Failed to draft document: {ex.Message}";
        }

        _isDrafting = false;
        StateHasChanged();
    }

    private string GetDraftName(string prompt, string result)
    {
        // Try to extract the first heading from the markdown
        var headingMatch = System.Text.RegularExpressions.Regex.Match(result, @"^#+\s+(.+)$", System.Text.RegularExpressions.RegexOptions.Multiline);
        if (headingMatch.Success)
        {
            var title = headingMatch.Groups[1].Value.Trim().Trim('*', '#', ' ', '\t');
            if (!string.IsNullOrEmpty(title) && title.Length < 100)
            {
                return $"Draft: {title}";
            }
        }

        // Fallback: truncated prompt
        var cleanPrompt = prompt.Trim().Replace("\r", "").Replace("\n", " ");
        if (cleanPrompt.Length > 50)
        {
            return $"Draft: {cleanPrompt[..47]}...";
        }
        return $"Draft: {cleanPrompt}";
    }

