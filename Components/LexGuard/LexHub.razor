    // ── Q&A Chat ──

    private async Task HandleChatKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_currentQuestion) && !_isChatting)
        {
            await SendChatMessage();
        }
    }

    private async Task SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(_currentQuestion) || string.IsNullOrEmpty(_currentRawText)) return;

        var userQ = _currentQuestion.Trim();
        _currentQuestion = "";
        _chatError = "";
        _isChatting = true;
        
        _chatHistory.Add(("user", userQ));
        StateHasChanged();

        try
        {
            var response = await AnalysisService.ChatWithDocumentAsync(_currentRawText, userQ, _chatHistory.TakeLast(6).ToList());
            _chatHistory.Add(("assistant", response));
        }
        catch (Exception ex)
        {
            _chatError = $"Chat failed: {ex.Message}";
            _chatHistory.RemoveAt(_chatHistory.Count - 1); // remove failed user message
            _currentQuestion = userQ; // restore question
        }

        _isChatting = false;
        StateHasChanged();
    }

    // ── Compare ──

    private async Task CompareDocuments()
    {
        if (string.IsNullOrWhiteSpace(_compareTextA) || string.IsNullOrWhiteSpace(_compareTextB)) return;

        _isComparing = true;
        _compareResult = "";
        _compareError = "";
        StateHasChanged();

        try
        {
            _compareResult = BASTION.Services.Legal.DocumentAnalysisService.RemoveHashCharacters(
                await AnalysisService.CompareDocumentsAsync(_compareTextA, _compareTextB));
        }
        catch (Exception ex)
        {
            _compareError = $"Comparison failed: {ex.Message}";
        }

        _isComparing = false;
        StateHasChanged();
    }

