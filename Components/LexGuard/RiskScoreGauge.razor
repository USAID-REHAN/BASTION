@* RiskScoreGauge.razor — SVG gauge — 0–100 document risk rating *@

<div class="lex-gauge-container">
    <svg class="lex-gauge-svg" viewBox="0 0 160 90">
        <!-- Background arc -->
        <path d="M 15 80 A 65 65 0 0 1 145 80"
              fill="none" stroke="rgba(148,163,184,0.15)" stroke-width="12"
              stroke-linecap="round" />

        <!-- Safe zone (green) -->
        <path d="M 15 80 A 65 65 0 0 1 58 22"
              fill="none" stroke="rgba(16,185,129,0.2)" stroke-width="12"
              stroke-linecap="round" />

        <!-- Caution zone (amber) -->
        <path d="M 58 22 A 65 65 0 0 1 102 22"
              fill="none" stroke="rgba(245,158,11,0.2)" stroke-width="12"
              stroke-linecap="round" />

        <!-- Danger zone (red) -->
        <path d="M 102 22 A 65 65 0 0 1 145 80"
              fill="none" stroke="rgba(239,68,68,0.2)" stroke-width="12"
              stroke-linecap="round" />

        <!-- Score arc (animated) -->
        <path d="M 15 80 A 65 65 0 0 1 145 80"
              fill="none" stroke="@_gaugeColor" stroke-width="12"
              stroke-linecap="round"
              stroke-dasharray="@_dashArray"
              style="transition: stroke-dasharray 1s ease, stroke 0.5s ease;" />

        <!-- Score text -->
        <text x="80" y="68" text-anchor="middle"
              fill="@_gaugeColor" font-size="28" font-weight="800"
              font-family="'JetBrains Mono', monospace">
            @Score
        </text>

        <text x="80" y="82" text-anchor="middle"
              fill="var(--text-muted)" font-size="9" font-weight="600">
            RISK SCORE
        </text>
    </svg>

    <span class="lex-gauge-label @RiskLevel.ToLower()">
        @(RiskLevel.ToUpper()) RISK
    </span>
</div>

@code {
    [Parameter] public int Score { get; set; }
    [Parameter] public string RiskLevel { get; set; } = "safe";

    private string _gaugeColor => RiskLevel.ToLower() switch
    {
        "danger" => "#EF4444",
        "caution" => "#F59E0B",
        _ => "#10B981"
    };

    // Total arc length ≈ 204 (for the semicircle path)
    private const double TotalArc = 204.0;

    private string _dashArray
    {
        get
        {
            var filled = (Score / 100.0) * TotalArc;
            return $"{filled:F1} {TotalArc:F1}";
        }
    }
}
