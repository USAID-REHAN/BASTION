@inject BASTION.Services.Sound.SoundService SoundService

<div class="settings-card">
    <div class="settings-card-title">Sound Effects</div>
    <div class="settings-card-desc">Control audio feedback in BASTION</div>

    <!-- Chime Setting -->
    <div class="toggle-row">
        <div class="toggle-info">
            <h4><i class="bi bi-volume-up"></i> Enable Chime</h4>
            <p>Play a chime on successful analysis and login</p>
        </div>
        <label class="toggle-switch">
            <input type="checkbox" checked="@SoundService.IsChimeEnabled" @onchange="ToggleChime" />
            <span class="toggle-slider"></span>
        </label>
    </div>

    <div style="margin-top: 10px; margin-bottom: 20px;">
        <button class="sound-preview-btn" @onclick="PreviewChime">
            <i class="bi bi-play-circle"></i> Preview Chime
        </button>
    </div>

    <!-- Beep Setting -->
    <div class="toggle-row" style="border-top: 1px solid var(--border-current); padding-top: 20px;">
        <div class="toggle-info">
            <h4><i class="bi bi-volume-down"></i> Enable Beep</h4>
            <p>Play a beep on unsuccessful login or errors</p>
        </div>
        <label class="toggle-switch">
            <input type="checkbox" checked="@SoundService.IsBeepEnabled" @onchange="ToggleBeep" />
            <span class="toggle-slider"></span>
        </label>
    </div>

    <div style="margin-top: 10px;">
        <button class="sound-preview-btn" @onclick="PreviewBeep">
            <i class="bi bi-play-circle"></i> Preview Beep
        </button>
    </div>
</div>

<!-- Background Music -->
<div class="settings-card" style="margin-top: 20px;">
    <div class="settings-card-title">Background Music</div>
    <div class="settings-card-desc">Choose a track to play in the background</div>

    <div style="display: grid; gap: 12px; margin-top: 15px;">
        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
            <input type="radio" name="bgm" value="none" checked="@(SoundService.SelectedBgm == "none")" @onchange='() => SelectBgm("none")' />
            <div>
                <div style="font-weight: 600;">None</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Silence</div>
            </div>
        </label>
        
        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
            <input type="radio" name="bgm" value="bgm1" checked="@(SoundService.SelectedBgm == "bgm1")" @onchange='() => SelectBgm("bgm1")' />
            <div>
                <div style="font-weight: 600;">Track 1</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Cyber Ambient (bgm1.mpeg)</div>
            </div>
        </label>

        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
            <input type="radio" name="bgm" value="bgm2" checked="@(SoundService.SelectedBgm == "bgm2")" @onchange='() => SelectBgm("bgm2")' />
            <div>
                <div style="font-weight: 600;">Track 2</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Neon Synth (bgm2.mpeg)</div>
            </div>
        </label>
    </div>
</div>

@code {
    private async Task ToggleChime(ChangeEventArgs e)
    {
        var enabled = (bool)(e.Value ?? true);
        await SoundService.SetChimeEnabled(enabled);
    }

    private async Task ToggleBeep(ChangeEventArgs e)
    {
        var enabled = (bool)(e.Value ?? true);
        await SoundService.SetBeepEnabled(enabled);
    }

    private async Task PreviewChime()
    {
        await SoundService.PlayPreviewChime();
    }

    private async Task PreviewBeep()
    {
        await SoundService.PlayPreviewBeep();
    }

    private async Task SelectBgm(string bgm)
    {
        await SoundService.SetBgm(bgm);
    }
}
