@inject IEnumerable<IModule> Modules
@inject NavigationManager Navigation
@inject BASTION.Services.Auth.AuthService AuthService

<aside class="bastion-sidebar @(IsCollapsed ? "collapsed" : "")">
    <!-- Logo & Toggle -->
    <div class="sidebar-logo" style="display: flex; align-items: center; gap: 14px; padding: 20px;">
        @if (!IsCollapsed)
        {
            <div class="sidebar-logo-icon">
                <i class="bi bi-shield-shaded"></i>
            </div>
            <div class="sidebar-logo-text">
                <span class="sidebar-brand">BASTION</span>
                <span class="sidebar-tagline">Digital Fortress</span>
            </div>
        }
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">
        @foreach (var module in Modules.Where(m => m.Name != "GateKeeper").OrderBy(m => m.Order))
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var isActive = (module.RouteUrl == "/" && string.IsNullOrEmpty(relativePath)) 
                           || (module.RouteUrl != "/" && module.RouteUrl.TrimStart('/') == relativePath);
            <a href="@module.RouteUrl"
               class="sidebar-item @(isActive ? "active" : "")"
               style="@(isActive ? $"--item-color: {module.PrimaryHex}" : "")">
                <i class="bi @module.Icon sidebar-item-icon" style="@(isActive ? $"color: {module.PrimaryHex}" : "")"></i>
                @if (!IsCollapsed)
                {
                    <span class="sidebar-item-text">@module.Name</span>
                }
            </a>
        }

        @if (AuthService.IsAdmin)
        {
            var isAdminActive = Navigation.Uri.Contains("/admin");
            <a href="/admin"
               class="sidebar-item @(isAdminActive ? "active" : "")"
               style="@(isAdminActive ? $"--item-color: var(--gate-primary)" : "")">
                <i class="bi bi-shield-lock sidebar-item-icon" style="@(isAdminActive ? $"color: var(--gate-primary)" : "")"></i>
                @if (!IsCollapsed)
                {
                    <span class="sidebar-item-text">Admin Portal</span>
                }
            </a>
        }
        

    </nav>

    <!-- Bottom Section -->
    <div class="sidebar-bottom">
        @if (!IsCollapsed)
        {
            <a href="/settings?tab=account" class="sidebar-user-info" style="text-decoration: none;">
                <div class="sidebar-user-avatar">
                    @AuthService.CurrentUser?.FullName?.Substring(0, 1).ToUpper()
                </div>
                <div class="sidebar-user-details">
                    <span class="sidebar-user-name">@AuthService.CurrentUser?.FullName</span>
                    <span class="sidebar-user-role badge-bastion @(AuthService.IsAdmin ? "badge-caution" : "badge-info")">
                        @AuthService.CurrentUser?.Role
                    </span>
                </div>
            </a>
        }
    </div>
</aside>

<style>
    .bastion-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background: linear-gradient(180deg, #090d16 0%, #05070c 100%);
        border-right: 1px solid rgba(255, 255, 255, 0.03);
        display: flex;
        flex-direction: column;
        z-index: 200;
        transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        box-shadow: 5px 0 25px rgba(0, 0, 0, 0.5);
    }

    .bastion-sidebar.collapsed {
        width: var(--sidebar-collapsed);
    }

    /* ── Logo ── */
    .sidebar-logo {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 24px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        background: rgba(255, 255, 255, 0.01);
    }

    .sidebar-logo-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #00f3ff, #ff0055); /* Cyberpunk gradient */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: white;
        flex-shrink: 0;
        box-shadow: 0 0 15px rgba(0, 243, 255, 0.3);
        transition: transform 0.3s ease;
    }
    
    .sidebar-logo:hover .sidebar-logo-icon {
        transform: rotate(5deg) scale(1.05);
    }

    .sidebar-brand {
        font-size: 1.25rem;
        font-weight: 900;
        letter-spacing: 4px;
        background: linear-gradient(to right, #ffffff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: block;
    }

    .sidebar-tagline {
        font-size: 0.65rem;
        color: #00f3ff; /* Cyan accent */
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        opacity: 0.8;
    }

    /* ── Nav Items ── */
    .sidebar-nav {
        flex: 1;
        padding: 20px 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
    }

    /* Custom Scrollbar for Sidebar */
    .sidebar-nav::-webkit-scrollbar {
        width: 4px;
    }
    .sidebar-nav::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 2px;
    }
    .sidebar-nav::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .sidebar-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border-radius: 12px;
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        border: 1px solid transparent;
    }

    .sidebar-item:hover {
        background: rgba(255, 255, 255, 0.02);
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.05);
        transform: translateX(4px);
    }

    .sidebar-item.active {
        background: rgba(255, 255, 255, 0.03);
        color: #ffffff;
        font-weight: 600;
        border-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .sidebar-item.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 50%;
        background: var(--item-color, #00f3ff);
        border-radius: 0 4px 4px 0;
        box-shadow: 0 0 10px var(--item-color, #00f3ff);
    }

    .sidebar-item-icon {
        font-size: 1.25rem;
        width: 24px;
        text-align: center;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }
    
    .sidebar-item:hover .sidebar-item-icon {
        transform: scale(1.1);
    }
    
    .sidebar-item.active .sidebar-item-icon {
        filter: drop-shadow(0 0 5px var(--item-color, #00f3ff));
    }

    /* ── Bottom Section ── */
    .sidebar-bottom {
        padding: 20px 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        background: rgba(255, 255, 255, 0.005);
    }

    .sidebar-user-info {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px;
        border-radius: 10px;
        transition: background 0.3s ease;
    }
    
    .sidebar-user-info:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .sidebar-user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, #00f3ff, #ff0055);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1rem;
        color: white;
        flex-shrink: 0;
        box-shadow: 0 0 10px rgba(0, 243, 255, 0.2);
    }

    .sidebar-user-name {
        font-size: 0.9rem;
        font-weight: 600;
        display: block;
        color: #ffffff;
    }

    .sidebar-user-role {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.8;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .bastion-sidebar {
            transform: translateX(-100%);
        }
        .bastion-sidebar:not(.collapsed) {
            transform: translateX(0);
        }
    }
</style>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
